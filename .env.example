# Copia este archivo a .env.local y completa los valores reales.
# Nunca commitees .env.local ni ningún archivo .env con credenciales reales.

# --- Base de datos (Neon PostgreSQL) ---
# DATABASE_URL: conexión pooled (pgbouncer) — usada en runtime por Prisma Client.
# Obtenla en el dashboard de Neon → tu proyecto → "Connect" → "Pooled connection".
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.neon.tech/DBNAME?sslmode=require"

# DIRECT_URL: conexión directa (sin pooling) — usada por Prisma Migrate / CLI.
# Mismo dashboard → "Connect" → "Direct connection".
DIRECT_URL="postgresql://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=require"

# --- Auth.js ---
# AUTH_SECRET: genera uno con `npx auth secret` o `openssl rand -base64 33`.
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# --- Aplicación ---
NEXT_PUBLIC_APP_NAME="Poker Manager"
APP_TIMEZONE="America/Monterrey"

# --- Datos bancarios (Módulo 02) ---
# Clave AES-256 para cifrar número de cuenta y CLABE. Requerida solo para
# capturar esos datos. Genera una con: openssl rand -base64 32
SETTINGS_ENCRYPTION_KEY=""

# --- WhatsApp Cloud API (PENDIENTE — Módulo 13) ---
# El número exclusivo de Poker Manager aún no está disponible. Deja estas
# variables vacías: la app funciona sin ellas y no envía mensajes.
# Nunca pongas estos secretos en la base de datos ni con prefijo NEXT_PUBLIC_.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# ── Módulo 15: respaldos y recuperación (solo en el equipo que ejecuta el CLI;
# nunca NEXT_PUBLIC_). Ver docs/BACKUP_SETUP.md. Sin valores en el repositorio.
BACKUP_STORAGE_DIR=
BACKUP_ENCRYPTION_KEY=
BACKUP_SOURCE_DATABASE_URL=
BACKUP_RETENTION_DAILY_DAYS=30
BACKUP_RETENTION_MONTHLY_MONTHS=6
RESTORE_TEST_DATABASE_URL=
RECOVERY_TARGET_DATABASE_URL=
