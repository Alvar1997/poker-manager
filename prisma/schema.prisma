// Poker Manager — Prisma schema
// Módulo 00: infraestructura mínima (usuarios + auditoría).
// Módulo 01: control de sesiones (sessionVersion), credenciales temporales,
// trazabilidad de altas/ediciones, resultado/requestId en auditoría y
// limitación de intentos de login.
// Módulo 02: configuración (negocio, caja central, mesas, juegos de fichas,
// denominaciones, métodos de pago, cuenta bancaria, folios, políticas y
// WhatsApp pendiente). Solo catálogos: ningún saldo ni movimiento.
// Módulo 03: jugadores (directorio, historial de teléfonos y consentimiento
// de notificaciones). Sin deudas, saldos ni límites de crédito.
// Módulo 04: inventario físico de fichas (maletines, existencias por juego y
// denominación, libro de movimientos, arqueos, conciliación y reservas).
// Módulo 05: caja central — libro financiero de partida doble, transferencias
// bancarias con verificación manual y arqueos de efectivo. Apertura en $0.
// Módulos 06–07: sesiones, mesas, ciclos y participación.
// Módulo 08: compras y recompras por importe nominal, pagos por componente
// (efectivo, transferencia, tarjeta por terminal), autorización de crédito
// por socio, entregas, deudas derivadas y outbox de notificaciones.
// Módulos 09–10: firmas, comprobantes, créditos, abonos y FIFO.
// Módulo 11: liquidaciones (devolución nominal, compensación OPCIONAL por
// FIFO, firma obligatoria, cuentas por pagar al jugador y desembolsos).
// El cierre de sesión se agrega en el Módulo 12 — ver docs/MODULES.md.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// En Prisma 7 la URL de conexión ya no vive aquí: la de runtime se pasa
// como adapter a PrismaClient (ver src/lib/prisma.ts, usa DATABASE_URL
// pooled) y la de Migrate se configura en prisma.config.ts (usa
// DIRECT_URL, sin pooling) — ver https://pris.ly/d/config-datasource.
datasource db {
  provider = "postgresql"
}

/// Rol de acceso de un usuario. Ampliable sin alterar la arquitectura principal.
enum Role {
  SUPERADMIN
  PARTNER
  CASHIER
}

/// Usuarios del sistema. Configuración inicial: 1 SUPERADMIN, 2 PARTNER, 1 CASHIER
/// (no es un límite). Nunca se eliminan físicamente: se desactivan (isActive)
/// para conservar su historial — ver docs/BUSINESS_RULES.md.
model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         Role
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  lastLoginAt  DateTime?

  /// true cuando la contraseña actual es una credencial temporal (alta o
  /// restablecimiento por SUPERADMIN): el usuario debe cambiarla antes de operar.
  mustChangePassword Boolean   @default(false)
  passwordChangedAt  DateTime?
  /// Se incrementa al cambiar/restablecer la contraseña, cambiar el rol o
  /// desactivar la cuenta. Los JWT emitidos con una versión anterior dejan
  /// de ser válidos en el servidor — ver docs/AUTHENTICATION.md.
  sessionVersion     Int       @default(0)

  createdById String?
  createdBy   User?   @relation("UserCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById String?
  updatedBy   User?   @relation("UserUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  usersCreated            User[]                     @relation("UserCreatedBy")
  usersUpdated            User[]                     @relation("UserUpdatedBy")
  auditLogs               AuditLog[]                 @relation("AuditLogActor")
  correctionsRequested    CorrectionRequest[]        @relation("CorrectionRequestedBy")
  correctionsExecuted     CorrectionRequest[]        @relation("CorrectionExecutedBy")
  correctionDecisions     CorrectionApproval[]       @relation("CorrectionDecidedBy")
  correctionEvents        CorrectionEvent[]          @relation("CorrectionEventActor")
  integrityRuns           IntegrityCheckRun[]        @relation("IntegrityRunTriggeredBy")
  incidentsCreated        OperationalIncident[]      @relation("IncidentCreatedBy")
  incidentsAssigned       OperationalIncident[]      @relation("IncidentAssignedTo")
  incidentsResolved       OperationalIncident[]      @relation("IncidentResolvedBy")
  incidentHistory         IncidentHistory[]          @relation("IncidentHistoryActor")
  backupsTriggered        BackupExecution[]          @relation("BackupTriggeredBy")
  restoreValidations      RestoreValidation[]        @relation("RestoreValidationRequestedBy")
  restoreRequests         RestoreRequest[]           @relation("RestoreRequestedBy")
  restoreApprovals        RestoreRequest[]           @relation("RestoreApprovedBy")
  maintenanceChanges      SystemMaintenance[]        @relation("MaintenanceChangedBy")
  redemptionsRequested    LateChipRedemption[]       @relation("RedemptionRequestedBy")
  redemptionsReceived     LateChipRedemption[]       @relation("RedemptionReceivedBy")
  specialPayablesCreated  SpecialPayable[]           @relation("SpecialPayableCreatedBy")
  specialPayoutsRequested SpecialPayout[]            @relation("SpecialPayoutRequestedBy")
  specialPayoutsResolved  SpecialPayout[]            @relation("SpecialPayoutResolvedBy")
  specialPayoutsCustody   SpecialPayout[]            @relation("SpecialPayoutCustodian")
  purchaseReversals       PurchaseReversal[]         @relation("PurchaseReversalExecutedBy")
  settlementCorrections   SettlementCorrection[]     @relation("SettlementCorrectionExecutedBy")
  specialEvidence         SpecialOperationEvidence[] @relation("SpecialEvidenceCapturedBy")
  specialReceipts         SpecialOperationReceipt[]  @relation("SpecialReceiptCreatedBy")

  // Trazabilidad de configuración (Módulo 02).
  businessSettingsUpdated BusinessSettings[] @relation("BusinessSettingsUpdatedBy")
  cashBoxesUpdated        CashBox[]          @relation("CashBoxUpdatedBy")
  chipSetsCreated         ChipSet[]          @relation("ChipSetCreatedBy")
  chipSetsUpdated         ChipSet[]          @relation("ChipSetUpdatedBy")
  denominationsCreated    ChipDenomination[] @relation("ChipDenominationCreatedBy")
  denominationsUpdated    ChipDenomination[] @relation("ChipDenominationUpdatedBy")
  tablesCreated           PokerTable[]       @relation("PokerTableCreatedBy")
  tablesUpdated           PokerTable[]       @relation("PokerTableUpdatedBy")
  paymentMethodsUpdated   PaymentMethod[]    @relation("PaymentMethodUpdatedBy")
  paymentAccountsCreated  PaymentAccount[]   @relation("PaymentAccountCreatedBy")
  paymentAccountsUpdated  PaymentAccount[]   @relation("PaymentAccountUpdatedBy")
  folioSequencesUpdated   FolioSequence[]    @relation("FolioSequenceUpdatedBy")

  // Trazabilidad de jugadores (Módulo 03). Los jugadores NO son usuarios.
  playersCreated         Player[]                    @relation("PlayerCreatedBy")
  playersUpdated         Player[]                    @relation("PlayerUpdatedBy")
  playerPhoneChanges     PlayerPhoneHistory[]        @relation("PlayerPhoneChangedBy")
  playerConsentsRecorded PlayerNotificationConsent[] @relation("PlayerConsentRecordedBy")

  // Inventario de fichas (Módulo 04).
  chipOperations       ChipInventoryOperation[] @relation("ChipOperationCreatedBy")
  chipMovements        ChipInventoryMovement[]  @relation("ChipMovementCreatedBy")
  chipNominalMovements ChipNominalMovement[]    @relation("ChipNominalMovementCreatedBy")

  // Sesiones (Módulo 06).
  sessionsCreated   PokerSession[]         @relation("SessionCreatedBy")
  sessionsOpened    PokerSession[]         @relation("SessionOpenedBy")
  sessionsCancelled PokerSession[]         @relation("SessionCancelledBy")
  sessionOpenings   SessionOpening[]       @relation("SessionOpeningConfirmedBy")
  sessionStatusLog  SessionStatusHistory[] @relation("SessionStatusChangedBy")

  // Mesas y participación (Módulo 07).
  tableCyclesOpened    SessionTableCycle[]     @relation("CycleOpenedBy")
  tableCyclesClosed    SessionTableCycle[]     @relation("CycleClosedBy")
  participationsAdded  TableParticipation[]    @relation("ParticipationJoinedBy")
  participationsEnded  TableParticipation[]    @relation("ParticipationLeftBy")
  tableTransfers       TableTransfer[]         @relation("TransferredBy")
  chipCountsCounted    ChipStockCount[]        @relation("ChipCountCountedBy")
  chipCountsConfirmed  ChipStockCount[]        @relation("ChipCountConfirmedBy")
  chipCountsReconciled ChipStockCount[]        @relation("ChipCountReconciledBy")
  chipReservations     ChipReservation[]       @relation("ChipReservationCreatedBy")
  chipSetsInitialized  ChipSetInventoryState[] @relation("ChipSetInitializedBy")

  // Caja central (Módulo 05).
  cashTransactionsCreated      CashTransaction[]          @relation("CashTransactionCreatedBy")
  cashTransactionsConfirmed    CashTransaction[]          @relation("CashTransactionConfirmedBy")
  bankTransfersCreated         BankTransferVerification[] @relation("BankTransferCreatedBy")
  bankTransfersVerified        BankTransferVerification[] @relation("BankTransferVerifiedBy")
  cashReconciliationsCreated   CashReconciliation[]       @relation("CashReconciliationCreatedBy")
  cashReconciliationsConfirmed CashReconciliation[]       @relation("CashReconciliationConfirmedBy")
  cashReconciliationsAdjusted  CashReconciliation[]       @relation("CashReconciliationAdjustedBy")

  // Compras y recompras (Módulo 08).
  purchasesCreated             ChipPurchase[]                @relation("PurchaseCreatedBy")
  purchasesConfirmed           ChipPurchase[]                @relation("PurchaseConfirmedBy")
  purchasesCancelled           ChipPurchase[]                @relation("PurchaseCancelledBy")
  purchasePaymentsCreated      PurchasePayment[]             @relation("PurchasePaymentCreatedBy")
  purchasePaymentsResolved     PurchasePayment[]             @relation("PurchasePaymentResolvedBy")
  creditAuthorizationsGiven    PurchaseCreditAuthorization[] @relation("CreditAuthorizedByPartner")
  creditAuthorizationsRecorded PurchaseCreditAuthorization[] @relation("CreditAuthorizationRecordedBy")
  purchaseDeliveries           PurchaseDelivery[]            @relation("PurchaseDeliveredBy")
  purchaseStatusChanges        PurchaseStatusHistory[]       @relation("PurchaseStatusChangedBy")
  purchaseReversalRequests     PurchaseReversalRequest[]     @relation("PurchaseReversalRequestedBy")
  playerDebtsCreated           PlayerDebt[]                  @relation("PlayerDebtCreatedBy")
  cardSettlementsCreated       CardTerminalSettlement[]      @relation("CardSettlementCreatedBy")

  // Firmas y comprobantes (Módulo 09).
  signatureSnapshotsPrepared SignatureSnapshot[] @relation("SnapshotPreparedBy")
  signatureSnapshotsPartner  SignatureSnapshot[] @relation("SnapshotPartner")
  signaturesCaptured         PurchaseSignature[] @relation("SignatureCapturedBy")
  signaturesInvalidated      PurchaseSignature[] @relation("SignatureInvalidatedBy")
  storedFilesCreated         StoredFile[]        @relation("StoredFileCreatedBy")
  receiptsCreated            PurchaseReceipt[]   @relation("ReceiptCreatedBy")
  receiptsVoided             PurchaseReceipt[]   @relation("ReceiptVoidedBy")

  // Créditos y abonos (Módulo 10).
  receivablePaymentsCreated     ReceivablePayment[]              @relation("ReceivablePaymentCreatedBy")
  receivablePaymentsConfirmed   ReceivablePayment[]              @relation("ReceivablePaymentConfirmedBy")
  receivablePaymentsCustody     ReceivablePayment[]              @relation("ReceivablePaymentCustodian")
  allocationsCreated            PaymentAllocation[]              @relation("AllocationCreatedBy")
  paymentReversalsCreated       ReceivablePaymentReversal[]      @relation("PaymentReversalCreatedBy")
  unappliedFundsCreated         UnappliedPlayerFunds[]           @relation("UnappliedFundsCreatedBy")
  custodyDepositsCustodian      AdministrativeCashDeposit[]      @relation("CustodyDepositCustodian")
  custodyDepositsCreated        AdministrativeCashDeposit[]      @relation("CustodyDepositCreatedBy")
  creditReceiptsCreated         ReceivablePaymentReceipt[]       @relation("CreditReceiptCreatedBy")
  custodyContributionsCustodian AdministrativeCashContribution[] @relation("CustodyContributionCustodian")
  custodyContributionsCreated   AdministrativeCashContribution[] @relation("CustodyContributionCreatedBy")

  // Liquidaciones (Módulo 11).
  settlementsCreated           PlayerSettlement[]            @relation("SettlementCreatedBy")
  settlementsReceived          PlayerSettlement[]            @relation("SettlementReceivedBy")
  settlementsCancelled         PlayerSettlement[]            @relation("SettlementCancelledBy")
  settlementStatusChanges      SettlementStatusHistory[]     @relation("SettlementStatusChangedBy")
  settlementSnapshotsPrepared  SettlementSignatureSnapshot[] @relation("SettlementSnapshotPreparedBy")
  settlementSignaturesCaptured SettlementSignature[]         @relation("SettlementSignatureCapturedBy")
  settlementSignaturesVoided   SettlementSignature[]         @relation("SettlementSignatureInvalidatedBy")
  settlementPayablesCreated    SettlementPayable[]           @relation("SettlementPayableCreatedBy")
  settlementPayoutsRequested   SettlementPayout[]            @relation("SettlementPayoutRequestedBy")
  settlementPayoutsResolved    SettlementPayout[]            @relation("SettlementPayoutResolvedBy")
  settlementPayoutsCustody     SettlementPayout[]            @relation("SettlementPayoutCustodian")
  settlementReceiptsCreated    SettlementReceipt[]           @relation("SettlementReceiptCreatedBy")
  settlementReversalsCreated   SettlementReversal[]          @relation("SettlementReversalCreatedBy")

  // Cierre de sesión (Módulo 12).
  closuresStarted              SessionClosure[]                 @relation("ClosureStartedBy")
  closuresReturned             SessionClosure[]                 @relation("ClosureReturnedBy")
  closureStatusChanges         ClosureStatusHistory[]           @relation("ClosureStatusChangedBy")
  closurePrechecks             ClosurePrecheck[]                @relation("ClosurePrecheckBy")
  closureDiscrepanciesResolved ClosureDiscrepancy[]             @relation("ClosureDiscrepancyResolvedBy")
  closureAdjustmentsAuthorized ClosureAdjustmentAuthorization[] @relation("ClosureAdjustmentAuthorizedBy")
  closureWithdrawalsMade       ClosureCashWithdrawal[]          @relation("ClosureWithdrawalBy")
  closureWithdrawalsReceived   ClosureCashWithdrawal[]          @relation("ClosureWithdrawalRecipient")
  closureApprovals             ClosureApproval[]                @relation("ClosureApprovedBy")
  closureReportsCreated        ClosureReport[]                  @relation("ClosureReportCreatedBy")

  @@index([role])
  @@index([isActive])
  @@map("users")
}

/// Resultado de una acción auditada.
enum AuditResult {
  SUCCESS
  FAILURE
  DENIED
}

/// Registro de auditoría de acciones del sistema.
/// Nunca debe contener contraseñas, tokens ni secretos — ver docs/BUSINESS_RULES.md.
model AuditLog {
  id             String      @id @default(cuid())
  actorUserId    String?
  actor          User?       @relation("AuditLogActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  action         String
  entityType     String
  entityId       String?
  result         AuditResult @default(SUCCESS)
  /// Identificador de la request HTTP (x-request-id) que originó el evento.
  requestId      String?
  metadata       Json?
  createdAt      DateTime    @default(now())
  // ── Módulo 15: auditoría transversal (columnas derivadas al insertar) ──
  /// Rol del actor EN EL MOMENTO del evento (no el actual).
  actorRole      Role?
  /// Módulo de origen (USERS, CASH, PURCHASES, …) derivado de la acción.
  module         String?
  sessionId      String?
  tableCycleId   String?
  playerId       String?
  idempotencyKey String?
  reason         String?
  /// Evento relacionado (p. ej. la solicitud que originó una decisión).
  relatedEventId String?
  /// Importe principal del evento cuando aplica (informativo).
  amount         Decimal?    @db.Decimal(14, 2)
  /// Referencia a evidencia (id de StoredFile, nunca la imagen).
  evidenceRef    String?

  @@index([actorUserId])
  @@index([entityType, entityId])
  @@index([action])
  @@index([createdAt])
  @@index([requestId])
  @@index([module, createdAt])
  @@index([sessionId])
  @@index([playerId])
  @@index([actorRole])
  @@map("audit_logs")
}

/// Contador de intentos fallidos de inicio de sesión (protección contra
/// fuerza bruta). Persistido en base de datos porque en un despliegue
/// serverless la memoria del proceso no se comparte entre instancias.
/// `key` es "email:<sha256 del correo>" o "ip:<dirección>" — nunca el correo
/// en claro ni contraseñas. Ver src/modules/auth/login-throttle.ts.
model LoginThrottle {
  key             String    @id
  failures        Int       @default(0)
  windowStartedAt DateTime
  lockedUntil     DateTime?
  updatedAt       DateTime  @updatedAt

  @@map("login_throttles")
}

// ─────────────────────────────────────────────────────────────────────────
// Módulo 02 — Configuración. Ver docs/MODULE_02_CONFIGURATION.md.
// Ningún modelo de este bloque guarda saldos, existencias ni movimientos:
// los saldos se calcularán a partir de los libros de movimientos de los
// módulos posteriores.
// ─────────────────────────────────────────────────────────────────────────

/// Configuración general del negocio. Registro ÚNICO: id = 1 (CHECK en BD).
model BusinessSettings {
  id           Int        @id @default(1)
  businessName String
  displayName  String?
  logoUrl      String?
  /// Fijo en esta versión (MXN): no editable desde la API.
  currency     String     @default("MXN")
  /// Fijo en esta versión (America/Monterrey): no editable desde la API.
  timezone     String     @default("America/Monterrey")
  dateFormat   DateFormat @default(DD_MM_YYYY)
  timeFormat   TimeFormat @default(H12)
  updatedById  String?
  updatedBy    User?      @relation("BusinessSettingsUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@map("business_settings")
}

enum DateFormat {
  DD_MM_YYYY
  YYYY_MM_DD
}

enum TimeFormat {
  H12
  H24
}

/// Caja financiera central — ÚNICA (CHECK code = 'MAIN'). Sin campo de
/// saldo: el saldo se derivará del libro de movimientos (módulos futuros).
/// No pertenece a ninguna mesa y no es un juego de fichas.
model CashBox {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  currency    String   @default("MXN")
  isActive    Boolean  @default(true)
  updatedById String?
  updatedBy   User?    @relation("CashBoxUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  financialAccounts FinancialAccount[]
  transactions      CashTransaction[]
  reconciliations   CashReconciliation[]
  pokerSessions     PokerSession[]

  @@map("cash_boxes")
}

/// Juego FÍSICO de fichas. Cada juego es una identidad de inventario
/// propia: dos fichas del mismo valor en juegos distintos son entidades
/// distintas. Nunca se borra; se desactiva.
model ChipSet {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdById String?
  createdBy   User?    @relation("ChipSetCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById String?
  updatedBy   User?    @relation("ChipSetUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  denominations ChipDenomination[]
  tables        PokerTable[]

  // Inventario (Módulo 04).
  containers         ChipContainer[]
  inventoryState     ChipSetInventoryState?
  inventoryBalances  ChipInventoryBalance[]
  inventoryOps       ChipInventoryOperation[]
  inventoryMovements ChipInventoryMovement[]
  nominalMovements   ChipNominalMovement[]
  stockCounts        ChipStockCount[]
  reservations       ChipReservation[]

  @@index([isActive])
  @@map("chip_sets")
}

/// Denominación de un juego de fichas. Sin cantidades: las existencias
/// pertenecen al inventario (módulo posterior). Nunca se borra.
model ChipDenomination {
  id          String   @id @default(cuid())
  chipSetId   String
  chipSet     ChipSet  @relation(fields: [chipSetId], references: [id], onDelete: Restrict)
  /// Valor monetario (Decimal, nunca Float). > 0 (CHECK en BD).
  value       Decimal  @db.Decimal(12, 2)
  name        String?
  color       String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdById String?
  createdBy   User?    @relation("ChipDenominationCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById String?
  updatedBy   User?    @relation("ChipDenominationUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Inventario (Módulo 04): las FK compuestas (chipSetId, id) impiden que
  // una existencia o movimiento mezcle una denominación de otro juego.
  balances         ChipInventoryBalance[]
  movements        ChipInventoryMovement[]
  countDetails     ChipStockCountDetail[]
  reservationItems ChipReservationItem[]

  @@unique([chipSetId, value])
  @@unique([chipSetId, id])
  @@index([chipSetId, isActive])
  @@map("chip_denominations")
}

/// Mesa del catálogo. Las sesiones futuras guardarán una fotografía
/// (snapshot) de ciegas y juego de fichas: cambiar esta configuración no
/// altera el histórico. No crea ninguna caja. Nunca se borra.
model PokerTable {
  id               String   @id @default(cuid())
  code             String   @unique
  name             String
  smallBlind       Decimal  @db.Decimal(12, 2)
  bigBlind         Decimal  @db.Decimal(12, 2)
  defaultChipSetId String
  defaultChipSet   ChipSet  @relation(fields: [defaultChipSetId], references: [id], onDelete: Restrict)
  isActive         Boolean  @default(true)
  sortOrder        Int      @default(0)
  createdById      String?
  createdBy        User?    @relation("PokerTableCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById      String?
  updatedBy        User?    @relation("PokerTableUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  cashTransactions CashTransaction[]
  bankTransfers    BankTransferVerification[]

  // Inventario compartido: trazabilidad de la mesa de origen.
  chipOperations   ChipInventoryOperation[] @relation("ChipOperationTable")
  chipMovements    ChipInventoryMovement[]  @relation("ChipMovementTable")
  chipReservations ChipReservation[]        @relation("ChipReservationTable")
  chipNominalMoves ChipNominalMovement[]    @relation("ChipNominalMovementTable")
  sessionTables    SessionTable[]
  purchases        ChipPurchase[]
  settlements      PlayerSettlement[]

  @@index([isActive])
  @@index([defaultChipSetId])
  @@map("poker_tables")
}

/// Formas en que entra dinero real. No existe MIXED (un pago mixto será una
/// operación con componentes) ni CREDIT (el crédito es una cuenta por cobrar).
enum PaymentMethodCode {
  CASH
  BANK_TRANSFER
  /// Tarjeta de débito cobrada en terminal física (Módulo 08).
  CARD_DEBIT
  /// Tarjeta de crédito cobrada en terminal física (Módulo 08). NO es el
  /// crédito del jugador: es dinero aprobado por el banco emisor.
  CARD_CREDIT
}

model PaymentMethod {
  id          String            @id @default(cuid())
  code        PaymentMethodCode @unique
  name        String
  isActive    Boolean           @default(true)
  sortOrder   Int               @default(0)
  updatedById String?
  updatedBy   User?             @relation("PaymentMethodUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@map("payment_methods")
}

enum PaymentAccountType {
  BANK
}

/// Cuenta receptora de transferencias. Solo una activa y principal (índice
/// único parcial en BD). Números cifrados (AES-256-GCM) + últimos 4 dígitos
/// para mostrar enmascarado. Nunca claves de banca electrónica ni tokens.
/// Reemplazar la cuenta crea un registro nuevo y desactiva el anterior.
model PaymentAccount {
  id                     String             @id @default(cuid())
  name                   String
  type                   PaymentAccountType @default(BANK)
  bankName               String?
  accountHolder          String?
  accountNumberEncrypted String?
  accountNumberLast4     String?
  clabeEncrypted         String?
  clabeLast4             String?
  isActive               Boolean            @default(true)
  isPrimary              Boolean            @default(false)
  createdById            String?
  createdBy              User?              @relation("PaymentAccountCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById            String?
  updatedBy              User?              @relation("PaymentAccountUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  bankTransfers     BankTransferVerification[]
  settlementPayouts SettlementPayout[]

  @@map("payment_accounts")
}

enum FolioDocumentType {
  SESSION
  PURCHASE
  DEBT_PAYMENT
  SETTLEMENT
  CASH_MOVEMENT
  CHIP_MOVEMENT
  CASH_CLOSING
  /// Módulo 15: solicitudes de corrección excepcional (COR-).
  CORRECTION
  /// Módulo 15: incidencias operativas (INC-).
  INCIDENT
  /// Módulo 16: canje posterior de fichas (CAN-).
  REDEMPTION
  /// Módulo 16: reverso de compra confirmada (REV-).
  PURCHASE_REVERSAL
  /// Módulo 16: corrección de liquidación (AJL-).
  SETTLEMENT_CORRECTION
  /// Módulo 16: pago de una obligación especial (PES-).
  SPECIAL_PAYOUT
}

/// Consecutivo de folios por tipo de documento. La emisión es atómica
/// (UPDATE … RETURNING) y el formato se bloquea tras el primer folio.
model FolioSequence {
  id           String            @id @default(cuid())
  documentType FolioDocumentType @unique
  prefix       String
  nextNumber   Int               @default(1)
  padding      Int               @default(6)
  isActive     Boolean           @default(true)
  /// Primer/último folio emitido. Si no es null, el formato ya no es editable.
  lastIssuedAt DateTime?
  updatedById  String?
  updatedBy    User?             @relation("FolioSequenceUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@map("folio_sequences")
}

/// Módulo 05: la caja física SIEMPRE abre en $0.00 (sin fondo inicial,
/// sin arrastre). Reemplaza a NEW_FUND_PER_SESSION del Módulo 02.
enum InitialCashPolicy {
  ZERO_OPENING_BALANCE
}

enum ClosingCashPolicy {
  FULL_WITHDRAWAL
}

/// Políticas operativas configurables. Registro ÚNICO (id = 1). Las reglas
/// invariables de esta versión viven como constantes de dominio en
/// src/config/operational-rules.ts, no aquí.
model OperationalSettings {
  id                       Int               @id @default(1)
  initialCashPolicy        InitialCashPolicy @default(ZERO_OPENING_BALANCE)
  closingCashPolicy        ClosingCashPolicy @default(FULL_WITHDRAWAL)
  /// Invariantes del Módulo 05 (CHECK en BD: no pueden cambiarse).
  openingCashBalance       Decimal           @default(0) @db.Decimal(14, 2)
  requireOpeningCashFund   Boolean           @default(false)
  carryCashToNextSession   Boolean           @default(false)
  allowNegativeCashBalance Boolean           @default(false)
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt

  @@map("operational_settings")
}

enum WhatsAppProvider {
  META_CLOUD_API
}

enum WhatsAppConfigurationStatus {
  PENDING_CONFIGURATION
  CONFIGURED
}

/// Configuración NO sensible de WhatsApp. Registro ÚNICO (id = 1). Los
/// tokens/secretos nunca se guardan aquí (irán en variables de entorno).
/// No puede estar habilitada si no está configurada (CHECK en BD).
model WhatsAppSettings {
  id                  Int                         @id @default(1)
  provider            WhatsAppProvider            @default(META_CLOUD_API)
  senderPhone         String?
  phoneNumberId       String?
  businessAccountId   String?
  enabled             Boolean                     @default(false)
  configurationStatus WhatsAppConfigurationStatus @default(PENDING_CONFIGURATION)
  lastVerifiedAt      DateTime?
  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @updatedAt

  @@map("whatsapp_settings")
}

// ─────────────────────────────────────────────────────────────────────────
// Módulo 03 — Jugadores. Ver docs/MODULE_03_PLAYERS.md.
// Un jugador es una entidad del negocio, NO un usuario: sin correo,
// contraseña ni rol. No hay campos de deuda, saldo, compras ni límite de
// crédito: esos valores se derivarán de operaciones confirmadas.
// ─────────────────────────────────────────────────────────────────────────

/// Jugador. Nunca se borra físicamente: se desactiva (isActive).
model Player {
  id          String   @id @default(cuid())
  name        String
  nickname    String?
  /// Teléfono normalizado E.164 (p. ej. +528711234567). ÚNICO en la base.
  phone       String   @unique
  /// País del número (ISO 3166-1 alfa-2, p. ej. "MX"), detectado al normalizar.
  countryCode String
  isActive    Boolean  @default(true)
  /// Observaciones operativas internas (texto plano, nunca se envían por WhatsApp).
  notes       String?
  createdById String?
  createdBy   User?    @relation("PlayerCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById String?
  updatedBy   User?    @relation("PlayerUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  phoneHistory       PlayerPhoneHistory[]
  lateRedemptions    LateChipRedemption[]          @relation("RedemptionPlayer")
  specialPayables    SpecialPayable[]              @relation("SpecialPayablePlayer")
  consents           PlayerNotificationConsent[]
  cashTransactions   CashTransaction[]
  bankTransfers      BankTransferVerification[]
  chipOperations     ChipInventoryOperation[]      @relation("ChipOperationPlayer")
  chipMovements      ChipInventoryMovement[]       @relation("ChipMovementPlayer")
  chipReservations   ChipReservation[]             @relation("ChipReservationPlayer")
  chipNominalMoves   ChipNominalMovement[]         @relation("ChipNominalMovementPlayer")
  participations     TableParticipation[]
  tableTransfers     TableTransfer[]
  purchases          ChipPurchase[]
  debts              PlayerDebt[]
  notifications      NotificationOutbox[]
  signatureSnaps     SignatureSnapshot[]
  signatures         PurchaseSignature[]
  receivablePayments ReceivablePayment[]
  allocations        PaymentAllocation[]
  unappliedFunds     UnappliedPlayerFunds[]
  settlements        PlayerSettlement[]
  settlementPayables SettlementPayable[]
  settlementPayouts  SettlementPayout[]
  settlementSnaps    SettlementSignatureSnapshot[]
  settlementSigs     SettlementSignature[]

  @@index([isActive, name])
  @@index([name])
  @@index([nickname])
  @@index([createdAt])
  @@map("players")
}

/// Historial de cambios de teléfono (datos personales: acceso restringido).
/// Solo inserción. Los comprobantes futuros guardarán su propio teléfono.
model PlayerPhoneHistory {
  id            String   @id @default(cuid())
  playerId      String
  player        Player   @relation(fields: [playerId], references: [id], onDelete: Restrict)
  previousPhone String
  newPhone      String
  reason        String?
  changedById   String?
  changedBy     User?    @relation("PlayerPhoneChangedBy", fields: [changedById], references: [id], onDelete: SetNull)
  changedAt     DateTime @default(now())

  @@index([playerId, changedAt])
  @@map("player_phone_history")
}

enum NotificationChannel {
  WHATSAPP
}

enum NotificationConsentType {
  TRANSACTIONAL
}

enum ConsentAction {
  GRANTED
  REVOKED
}

enum ConsentSource {
  IN_PERSON
  ADMIN_ENTRY
}

/// Historial de consentimiento de notificaciones (solo inserción). El
/// consentimiento VIGENTE se deriva del registro más reciente por canal y
/// solo aplica al teléfono para el que se otorgó (`phone`): si el jugador
/// cambia de número, el consentimiento anterior deja de estar vigente.
model PlayerNotificationConsent {
  id                String                  @id @default(cuid())
  playerId          String
  player            Player                  @relation(fields: [playerId], references: [id], onDelete: Restrict)
  channel           NotificationChannel     @default(WHATSAPP)
  consentType       NotificationConsentType @default(TRANSACTIONAL)
  action            ConsentAction
  /// Teléfono E.164 al que aplica este registro.
  phone             String
  noticeVersion     String
  source            ConsentSource
  evidenceReference String?
  notes             String?
  recordedById      String?
  recordedBy        User?                   @relation("PlayerConsentRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)
  recordedAt        DateTime                @default(now())

  @@index([playerId, channel, recordedAt])
  @@map("player_notification_consents")
}

// ─────────────────────────────────────────────────────────────────────────
// Módulo 04 — Inventario físico de fichas. Ver docs/MODULE_04_CHIP_INVENTORY.md.
// Las fichas NO son dinero: nada de este bloque toca la caja financiera.
// Identidad de inventario = (juego físico, denominación). Todas las FK
// compuestas (chipSetId, …) garantizan en la base que no se mezclen juegos.
// ─────────────────────────────────────────────────────────────────────────

/// Contenedor físico (maletín) de UN juego de fichas. Nunca se borra.
model ChipContainer {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  chipSetId   String
  chipSet     ChipSet  @relation(fields: [chipSetId], references: [id], onDelete: Restrict)
  description String?
  /// Un solo contenedor principal activo por juego (índice parcial en BD).
  isPrimary   Boolean  @default(true)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  balances     ChipInventoryBalance[]
  operations   ChipInventoryOperation[]
  movements    ChipInventoryMovement[]
  stockCounts  ChipStockCount[]
  reservations ChipReservation[]

  @@unique([chipSetId, id])
  @@index([chipSetId])
  @@map("chip_containers")
}

/// Estado de inventario por juego: renglón de BLOQUEO (SELECT … FOR UPDATE)
/// que serializa todas las operaciones de un juego, y versión que cambia en
/// cada movimiento (detecta arqueos con esperado obsoleto).
model ChipSetInventoryState {
  chipSetId          String    @id
  chipSet            ChipSet   @relation(fields: [chipSetId], references: [id], onDelete: Restrict)
  version            Int       @default(0)
  initializedAt      DateTime?
  initializedById    String?
  initializedBy      User?     @relation("ChipSetInitializedBy", fields: [initializedById], references: [id], onDelete: SetNull)
  initialCountId     String?   @unique
  /// SALDO NOMINAL operativo (compras por importe): fuente de verdad para
  /// disponibilidad. Bajo custodia, reservado (incluido en la custodia) y
  /// entregado a jugadores.
  custodyNominal     Decimal   @default(0) @db.Decimal(14, 2)
  reservedNominal    Decimal   @default(0) @db.Decimal(14, 2)
  circulationNominal Decimal   @default(0) @db.Decimal(14, 2)
  /// true mientras las cantidades por denominación sean exactas; las
  /// entregas/devoluciones por importe la vuelven false hasta el siguiente arqueo.
  breakdownExact     Boolean   @default(true)
  updatedAt          DateTime  @updatedAt

  @@map("chip_set_inventory_states")
}

/// Dónde está una ficha: bajo custodia del cajero (en el maletín), en
/// circulación (con jugadores) o retirada (baja definitiva).
enum ChipLocation {
  CUSTODY
  CIRCULATION
  RETIRED
}

/// Proyección de existencias por (maletín, denominación, ubicación). La
/// fuente auditable es el libro de movimientos; esta tabla se actualiza
/// SOLO en la misma transacción que los movimientos (servicios), con
/// CHECKs: quantity ≥ 0, 0 ≤ reserved ≤ quantity, reserved solo en CUSTODY.
model ChipInventoryBalance {
  id             String           @id @default(cuid())
  chipSetId      String
  chipSet        ChipSet          @relation(fields: [chipSetId], references: [id], onDelete: Restrict)
  denominationId String
  denomination   ChipDenomination @relation(fields: [chipSetId, denominationId], references: [chipSetId, id], onDelete: Restrict)
  containerId    String
  container      ChipContainer    @relation(fields: [chipSetId, containerId], references: [chipSetId, id], onDelete: Restrict)
  location       ChipLocation
  quantity       Int              @default(0)
  /// Fichas apartadas para una entrega futura (siguen en el maletín).
  reserved       Int              @default(0)
  version        Int              @default(0)
  updatedAt      DateTime         @updatedAt

  @@unique([containerId, denominationId, location])
  @@index([chipSetId])
  @@map("chip_inventory_balances")
}

enum ChipOperationType {
  INITIAL_STOCK
  STOCK_ENTRY
  STOCK_WITHDRAWAL
  INVENTORY_ADJUSTMENT
  COUNT_RECONCILIATION
  CHIP_DELIVERY
  CHIP_RETURN
  INTERNAL_TRANSFER
  CHIP_CONVERSION
  /// Actualiza la composición por denominación a lo contado en un arqueo
  /// (no cambia el valor nominal).
  COMPOSITION_UPDATE
}

enum ChipMovementType {
  INITIAL_STOCK
  STOCK_ENTRY
  STOCK_WITHDRAWAL
  INVENTORY_ADJUSTMENT
  CHIP_DELIVERY
  CHIP_RETURN
  INTERNAL_TRANSFER
  CHIP_CONVERSION
  REVERSAL
  COMPOSITION_UPDATE
}

/// Causa de una baja definitiva (no es una salida hacia un jugador).
enum ChipWithdrawalCategory {
  DAMAGE
  CONFIRMED_LOSS
  PERMANENT_RETIREMENT
  OTHER
}

enum ChipAdjustmentKind {
  SHORTAGE
  SURPLUS
  CORRECTION
}

/// Encabezado de una operación (una solicitud). La clave de idempotencia
/// es ÚNICA: repetir la solicitud no vuelve a mover inventario. Inmutable.
model ChipInventoryOperation {
  id                 String                  @id @default(cuid())
  type               ChipOperationType
  chipSetId          String
  chipSet            ChipSet                 @relation(fields: [chipSetId], references: [id], onDelete: Restrict)
  containerId        String
  container          ChipContainer           @relation(fields: [chipSetId, containerId], references: [chipSetId, id], onDelete: Restrict)
  idempotencyKey     String                  @unique
  /// Huella del contenido de la solicitud: misma clave + datos distintos → 409.
  requestHash        String
  adjustmentKind     ChipAdjustmentKind?
  withdrawalCategory ChipWithdrawalCategory?
  reason             String?
  notes              String?
  referenceType      String?
  referenceId        String?
  stockCountId       String?
  /// Contexto operativo (inventario compartido): mesa, sesión y jugador de origen.
  tableId            String?
  table              PokerTable?             @relation("ChipOperationTable", fields: [tableId], references: [id], onDelete: Restrict)
  sessionId          String?
  playerId           String?
  player             Player?                 @relation("ChipOperationPlayer", fields: [playerId], references: [id], onDelete: Restrict)
  createdById        String?
  createdBy          User?                   @relation("ChipOperationCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt          DateTime                @default(now())

  movements         ChipInventoryMovement[]
  nominalMovements  ChipNominalMovement[]
  closureAdjustment ClosureAdjustmentAuthorization? @relation("ClosureAdjustmentChipOperation")

  @@unique([id, chipSetId])
  @@index([chipSetId, createdAt])
  @@index([referenceType, referenceId])
  @@index([tableId, createdAt])
  @@index([sessionId])
  @@map("chip_inventory_operations")
}

/// Libro de movimientos (fuente auditable). Solo inserción (trigger).
/// fromLocation/toLocation null = fuera del inventario (alta o pérdida).
model ChipInventoryMovement {
  id             String                 @id @default(cuid())
  operationId    String
  operation      ChipInventoryOperation @relation(fields: [operationId, chipSetId], references: [id, chipSetId], onDelete: Restrict)
  chipSetId      String
  chipSet        ChipSet                @relation(fields: [chipSetId], references: [id], onDelete: Restrict)
  denominationId String
  denomination   ChipDenomination       @relation(fields: [chipSetId, denominationId], references: [chipSetId, id], onDelete: Restrict)
  containerId    String
  container      ChipContainer          @relation(fields: [chipSetId, containerId], references: [chipSetId, id], onDelete: Restrict)
  /// Copias históricas: el código del maletín y el valor nominal al momento.
  containerCode  String
  unitValue      Decimal                @db.Decimal(12, 2)
  movementType   ChipMovementType
  /// Siempre > 0; el sentido lo dan origen y destino.
  quantity       Int
  fromLocation   ChipLocation?
  toLocation     ChipLocation?
  /// Existencias bajo custodia antes y después de este movimiento.
  custodyBefore  Int
  custodyAfter   Int
  reason         String?
  referenceType  String?
  referenceId    String?
  /// Mesa, sesión y jugador de origen (el stock es común; la mesa solo traza).
  tableId        String?
  table          PokerTable?            @relation("ChipMovementTable", fields: [tableId], references: [id], onDelete: Restrict)
  sessionId      String?
  playerId       String?
  player         Player?                @relation("ChipMovementPlayer", fields: [playerId], references: [id], onDelete: Restrict)
  createdById    String?
  createdBy      User?                  @relation("ChipMovementCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt      DateTime               @default(now())

  @@index([chipSetId, createdAt])
  @@index([denominationId, createdAt])
  @@index([movementType])
  @@index([createdById])
  @@index([operationId])
  @@index([tableId, createdAt])
  @@map("chip_inventory_movements")
}

enum ChipCountType {
  INITIAL
  OPENING
  CONTROL
  CLOSING
}

enum ChipCountStatus {
  DRAFT
  CONFIRMED
  CANCELLED
}

/// Estado de las DIFERENCIAS de un arqueo (independiente de su estado).
enum ChipReconciliationStatus {
  NOT_REQUIRED
  PENDING
  RECONCILED
  /// Diferencia de un arqueo de CIERRE sustituida por un recuento físico
  /// posterior o por el regreso auditado de la sesión a OPEN (Módulo 12).
  /// No hubo ajuste: el arqueo original se conserva como evidencia.
  SUPERSEDED
}

/// Arqueo físico de un juego/maletín. Motor único que reutilizarán las
/// sesiones (OPENING/CLOSING). Confirmado = snapshot inmutable.
/// Libro NOMINAL del inventario (inmutable): cada cambio del valor bajo
/// custodia o en circulación. Las entregas y devoluciones por importe solo
/// se registran aquí, sin desglose por denominación.
model ChipNominalMovement {
  id                String                 @id @default(cuid())
  operationId       String
  operation         ChipInventoryOperation @relation(fields: [operationId, chipSetId], references: [id, chipSetId], onDelete: Restrict)
  chipSetId         String
  chipSet           ChipSet                @relation(fields: [chipSetId], references: [id], onDelete: Restrict)
  movementType      ChipMovementType
  /// Importe nominal (> 0); el sentido lo dan los antes/después.
  amount            Decimal                @db.Decimal(14, 2)
  custodyBefore     Decimal                @db.Decimal(14, 2)
  custodyAfter      Decimal                @db.Decimal(14, 2)
  circulationBefore Decimal                @db.Decimal(14, 2)
  circulationAfter  Decimal                @db.Decimal(14, 2)
  reason            String?
  referenceType     String?
  referenceId       String?
  tableId           String?
  table             PokerTable?            @relation("ChipNominalMovementTable", fields: [tableId], references: [id], onDelete: Restrict)
  sessionId         String?
  playerId          String?
  player            Player?                @relation("ChipNominalMovementPlayer", fields: [playerId], references: [id], onDelete: Restrict)
  createdById       String?
  createdBy         User?                  @relation("ChipNominalMovementCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt         DateTime               @default(now())

  @@index([chipSetId, createdAt])
  @@index([tableId, createdAt])
  @@index([sessionId])
  @@index([referenceType, referenceId])
  @@map("chip_nominal_movements")
}

model ChipStockCount {
  id                        String                   @id @default(cuid())
  chipSetId                 String
  chipSet                   ChipSet                  @relation(fields: [chipSetId], references: [id], onDelete: Restrict)
  containerId               String
  container                 ChipContainer            @relation(fields: [chipSetId, containerId], references: [chipSetId, id], onDelete: Restrict)
  countType                 ChipCountType
  status                    ChipCountStatus          @default(DRAFT)
  reconciliationStatus      ChipReconciliationStatus @default(NOT_REQUIRED)
  /// Versión de inventario con la que se calcularon las cantidades esperadas.
  inventoryVersion          Int
  expectedTotal             Decimal                  @default(0) @db.Decimal(14, 2)
  countedTotal              Decimal                  @default(0) @db.Decimal(14, 2)
  differenceTotal           Decimal                  @default(0) @db.Decimal(14, 2)
  notes                     String?
  reconciliationReason      String?
  /// Operación de ajuste que concilió las diferencias (única: no se aplica dos veces).
  reconciliationOperationId String?                  @unique
  /// La composición por denominación era exacta al calcular el esperado.
  breakdownExact            Boolean                  @default(true)
  /// Versión del inventario tras los efectos propios del arqueo (confirmación,
  /// actualización de composición y conciliación): criterio de vigencia.
  resultingInventoryVersion Int?
  /// Operación que actualizó la composición al confirmar (sin cambio nominal).
  compositionOperationId    String?                  @unique
  sessionId                 String?
  countedById               String?
  countedBy                 User?                    @relation("ChipCountCountedBy", fields: [countedById], references: [id], onDelete: SetNull)
  confirmedById             String?
  confirmedBy               User?                    @relation("ChipCountConfirmedBy", fields: [confirmedById], references: [id], onDelete: SetNull)
  reconciledById            String?
  reconciledBy              User?                    @relation("ChipCountReconciledBy", fields: [reconciledById], references: [id], onDelete: SetNull)
  createdAt                 DateTime                 @default(now())
  updatedAt                 DateTime                 @updatedAt
  confirmedAt               DateTime?
  reconciledAt              DateTime?
  cancelledAt               DateTime?

  details ChipStockCountDetail[]

  sessionOpening SessionOpening?

  closureDiscrepancy ClosureDiscrepancy? @relation("ClosureDiscrepancyChipCount")
  closureApproval    ClosureApproval?    @relation("ClosureApprovalChipCount")

  @@unique([id, chipSetId])
  @@index([chipSetId, createdAt])
  @@index([status])
  @@index([reconciliationStatus])
  @@index([status, confirmedAt])
  @@map("chip_stock_counts")
}

model ChipStockCountDetail {
  id                 String           @id @default(cuid())
  stockCountId       String
  stockCount         ChipStockCount   @relation(fields: [stockCountId, chipSetId], references: [id, chipSetId], onDelete: Restrict)
  chipSetId          String
  denominationId     String
  denomination       ChipDenomination @relation(fields: [chipSetId, denominationId], references: [chipSetId, id], onDelete: Restrict)
  unitValue          Decimal          @db.Decimal(12, 2)
  expectedQuantity   Int
  /// null mientras no se capture.
  countedQuantity    Int?
  differenceQuantity Int?

  @@unique([stockCountId, denominationId])
  @@map("chip_stock_count_details")
}

enum ChipReservationStatus {
  ACTIVE
  CONSUMED
  RELEASED
  EXPIRED
}

/// Reserva de fichas para una operación futura (compras). Reduce la
/// disponibilidad, no la custodia. Sin endpoints públicos en el Módulo 04.
model ChipReservation {
  id                 String                @id @default(cuid())
  chipSetId          String
  chipSet            ChipSet               @relation(fields: [chipSetId], references: [id], onDelete: Restrict)
  containerId        String
  container          ChipContainer         @relation(fields: [chipSetId, containerId], references: [chipSetId, id], onDelete: Restrict)
  status             ChipReservationStatus @default(ACTIVE)
  referenceType      String
  referenceId        String
  idempotencyKey     String                @unique
  expiresAt          DateTime
  consumeOperationId String?               @unique
  /// Importe nominal reservado (compras por importe). Las reservas antiguas
  /// por denominación usan `items` y dejan este campo vacío.
  amount             Decimal?              @db.Decimal(14, 2)
  tableId            String?
  table              PokerTable?           @relation("ChipReservationTable", fields: [tableId], references: [id], onDelete: Restrict)
  sessionId          String?
  playerId           String?
  player             Player?               @relation("ChipReservationPlayer", fields: [playerId], references: [id], onDelete: Restrict)
  createdById        String?
  createdBy          User?                 @relation("ChipReservationCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt          DateTime              @default(now())
  consumedAt         DateTime?
  releasedAt         DateTime?

  items ChipReservationItem[]

  @@unique([id, chipSetId])
  @@index([chipSetId, status])
  @@index([status, expiresAt])
  @@map("chip_reservations")
}

model ChipReservationItem {
  id             String           @id @default(cuid())
  reservationId  String
  reservation    ChipReservation  @relation(fields: [reservationId, chipSetId], references: [id, chipSetId], onDelete: Restrict)
  chipSetId      String
  denominationId String
  denomination   ChipDenomination @relation(fields: [chipSetId, denominationId], references: [chipSetId, id], onDelete: Restrict)
  quantity       Int

  @@unique([reservationId, denominationId])
  @@map("chip_reservation_items")
}

// ─────────────────────────────────────────────────────────────────────────
// Módulo 05 — Caja central. Ver docs/MODULE_05_CASH_BOX.md.
// Libro de PARTIDA DOBLE simplificado: cada transacción tiene partidas
// DEBIT/CREDIT que suman lo mismo (trigger diferido). Los saldos son una
// proyección mantenida en la misma transacción; el libro es la fuente.
// El efectivo se lleva POR SESIÓN (scopeKey = sessionId) y siempre abre en
// $0. `sessionId` es texto hasta que el Módulo 06 cree el modelo de sesión.
// ─────────────────────────────────────────────────────────────────────────

enum FinancialAccountKind {
  /// Dinero físico bajo custodia de la caja (por sesión, nunca negativo).
  CASH_ON_HAND
  /// Cuenta bancaria receptora única (historial persistente entre sesiones).
  BANK
  /// Depósitos de efectivo al banco aún no verificados (nunca negativo).
  CASH_IN_TRANSIT
  // ── Cuentas técnicas (no son dinero disponible) ──
  OWNER_CONTRIBUTIONS
  CASH_WITHDRAWALS
  PLAYER_PURCHASES
  PLAYER_DEBT_PAYMENTS
  PLAYER_SETTLEMENTS
  RECONCILIATION_DIFFERENCES
  /// Cobros con terminal APROBADOS pendientes de que el adquirente deposite
  /// (Módulo 08). No es efectivo ni banco liquidado (nunca negativo).
  CARD_TERMINAL_CLEARING
  /// Efectivo de abonos recibido FUERA de sesión, bajo custodia de un
  /// usuario (scopeKey = "custodian:<userId>"). No es caja de juego.
  ADMIN_CASH_CUSTODY
  /// Dinero real recibido que no pudo aplicarse a deudas (pendiente de
  /// devolución o conciliación). Nunca es saldo a favor del jugador.
  UNAPPLIED_PLAYER_FUNDS
}

enum FinancialAccountScope {
  SESSION
  GLOBAL
  /// Por custodio (efectivo administrativo).
  CUSTODIAN
}

/// Catálogo de cuentas (una por tipo, todas de la Caja Central MAIN).
model FinancialAccount {
  id          String                @id @default(cuid())
  kind        FinancialAccountKind  @unique
  code        String                @unique
  name        String
  cashBoxId   String
  cashBox     CashBox               @relation(fields: [cashBoxId], references: [id], onDelete: Restrict)
  /// true = representa dinero (efectivo, banco, en tránsito).
  isMoney     Boolean
  scope       FinancialAccountScope
  /// El saldo no puede ser negativo (CHECK sobre la proyección).
  nonNegative Boolean
  isActive    Boolean               @default(true)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  entries  CashTransactionEntry[]
  balances FinancialAccountBalance[]

  @@map("financial_accounts")
}

/// Proyección de saldo por cuenta y alcance ("GLOBAL" o el id de sesión).
/// Renglón de BLOQUEO (FOR UPDATE) para operaciones concurrentes.
model FinancialAccountBalance {
  id          String           @id @default(cuid())
  accountId   String
  account     FinancialAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)
  scopeKey    String
  /// Saldo deudor neto (DEBIT − CREDIT).
  balance     Decimal          @default(0) @db.Decimal(14, 2)
  nonNegative Boolean
  version     Int              @default(0)
  updatedAt   DateTime         @updatedAt

  @@unique([accountId, scopeKey])
  @@map("financial_account_balances")
}

/// Tipos permitidos (catálogo cerrado). NO existe ningún tipo de gasto
/// operativo ni categoría genérica de egreso.
enum CashTransactionType {
  CASH_CONTRIBUTION
  CASH_WITHDRAWAL
  CASH_TRANSFER
  BANK_TRANSFER_RECEIPT
  BANK_TRANSFER_PAYOUT
  PURCHASE_PAYMENT
  DEBT_PAYMENT
  PLAYER_SETTLEMENT
  REVERSAL
  CASH_RECONCILIATION_ADJUSTMENT
  /// Depósito de la terminal al banco: banco + / por liquidar − (no es venta).
  CARD_TERMINAL_SETTLEMENT
}

/// Destinos permitidos de un retiro. No incluye gastos.
enum CashWithdrawalDestination {
  OWNER_CUSTODY
  SAFEKEEPING
  CONTRIBUTION_RETURN
  SESSION_CLOSING
}

enum EntryDirection {
  DEBIT
  CREDIT
}

/// Movimiento financiero confirmado. INMUTABLE (trigger). Un error se
/// corrige con un REVERSAL (reversesTransactionId único: un solo reverso).
model CashTransaction {
  id                    String                     @id @default(cuid())
  folio                 String                     @unique
  transactionType       CashTransactionType
  cashBoxId             String
  cashBox               CashBox                    @relation(fields: [cashBoxId], references: [id], onDelete: Restrict)
  sessionId             String?
  tableId               String?
  table                 PokerTable?                @relation(fields: [tableId], references: [id], onDelete: Restrict)
  playerId              String?
  player                Player?                    @relation(fields: [playerId], references: [id], onDelete: Restrict)
  referenceType         String?
  referenceId           String?
  reason                String
  notes                 String?
  /// Quién entrega (aportación) o recibe (retiro) el dinero físicamente.
  counterpartyName      String?
  withdrawalDestination CashWithdrawalDestination?
  idempotencyKey        String                     @unique
  requestHash           String
  reversesTransactionId String?                    @unique
  reverses              CashTransaction?           @relation("CashTransactionReversal", fields: [reversesTransactionId], references: [id], onDelete: Restrict)
  reversedBy            CashTransaction?           @relation("CashTransactionReversal")
  createdById           String?
  createdBy             User?                      @relation("CashTransactionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  confirmedById         String?
  confirmedBy           User?                      @relation("CashTransactionConfirmedBy", fields: [confirmedById], references: [id], onDelete: SetNull)
  createdAt             DateTime                   @default(now())
  confirmedAt           DateTime                   @default(now())

  entries               CashTransactionEntry[]
  purchasePayment       PurchasePayment?                @relation("PurchasePaymentTransaction")
  receivablePayment     ReceivablePayment?              @relation("ReceivablePaymentTransaction")
  receivableReversal    ReceivablePaymentReversal?      @relation("ReceivableReversalTransaction")
  custodyDeposit        AdministrativeCashDeposit?      @relation("CustodyDepositTransaction")
  cardSettlement        CardTerminalSettlement?         @relation("CardSettlementTransaction")
  bankTransferConfirmed BankTransferVerification?       @relation("BankTransferTransaction")
  bankTransferDeposit   BankTransferVerification?       @relation("BankTransferDepositTransaction")
  reconciliation        CashReconciliation?             @relation("CashReconciliationAdjustment")
  settlementPayout      SettlementPayout?               @relation("SettlementPayoutTransaction")
  custodyContribution   AdministrativeCashContribution? @relation("CustodyContributionTransaction")
  closureWithdrawal     ClosureCashWithdrawal?          @relation("ClosureWithdrawalTransaction")
  specialPayout         SpecialPayout?                  @relation("SpecialPayoutTransaction")
  closureAdjustment     ClosureAdjustmentAuthorization? @relation("ClosureAdjustmentCashTransaction")

  @@index([transactionType, createdAt])
  @@index([sessionId])
  @@index([playerId])
  @@index([tableId])
  @@index([referenceType, referenceId])
  @@index([createdById])
  @@index([createdAt])
  @@index([confirmedAt])
  @@map("cash_transactions")
}

/// Partida de una transacción. amount > 0; el sentido lo da `direction`.
model CashTransactionEntry {
  id            String           @id @default(cuid())
  transactionId String
  transaction   CashTransaction  @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  accountId     String
  account       FinancialAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)
  direction     EntryDirection
  amount        Decimal          @db.Decimal(14, 2)
  /// "GLOBAL" o el id de la sesión (efectivo).
  scopeKey      String
  createdAt     DateTime         @default(now())

  @@index([transactionId])
  @@index([accountId, scopeKey])
  @@map("cash_transaction_entries")
}

enum BankTransferStatus {
  PENDING_VERIFICATION
  CONFIRMED
  REJECTED
  CANCELLED
}

enum BankTransferKind {
  /// Pago de un jugador (compra, abono) recibido por transferencia.
  PLAYER_PAYMENT
  /// Depósito de efectivo de la caja al banco (traslado interno).
  CASH_DEPOSIT
}

/// Transferencia declarada que requiere verificación MANUAL en el banco.
/// Pendiente ≠ cobro: solo al confirmarse genera el asiento financiero.
model BankTransferVerification {
  id                   String               @id @default(cuid())
  kind                 BankTransferKind
  status               BankTransferStatus   @default(PENDING_VERIFICATION)
  paymentAccountId     String
  paymentAccount       PaymentAccount       @relation(fields: [paymentAccountId], references: [id], onDelete: Restrict)
  declaredAmount       Decimal              @db.Decimal(14, 2)
  confirmedAmount      Decimal?             @db.Decimal(14, 2)
  bankReference        String?
  senderName           String?
  /// Cuenta técnica que se acredita al confirmar (p. ej. PLAYER_PURCHASES).
  creditAccountKind    FinancialAccountKind
  sessionId            String?
  tableId              String?
  table                PokerTable?          @relation(fields: [tableId], references: [id], onDelete: Restrict)
  playerId             String?
  player               Player?              @relation(fields: [playerId], references: [id], onDelete: Restrict)
  referenceType        String
  referenceId          String
  idempotencyKey       String               @unique
  notes                String?
  rejectionReason      String?
  verificationNotes    String?
  createdById          String?
  createdBy            User?                @relation("BankTransferCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt            DateTime             @default(now())
  verifiedById         String?
  verifiedBy           User?                @relation("BankTransferVerifiedBy", fields: [verifiedById], references: [id], onDelete: SetNull)
  verifiedAt           DateTime?
  /// Asiento al confirmar (único: no se contabiliza dos veces).
  transactionId        String?              @unique
  transaction          CashTransaction?     @relation("BankTransferTransaction", fields: [transactionId], references: [id], onDelete: Restrict)
  /// Para CASH_DEPOSIT: salida de efectivo hacia "en tránsito".
  depositTransactionId String?              @unique
  depositTransaction   CashTransaction?     @relation("BankTransferDepositTransaction", fields: [depositTransactionId], references: [id], onDelete: Restrict)
  updatedAt            DateTime             @updatedAt

  purchasePayment   PurchasePayment?
  receivablePayment ReceivablePayment?
  unappliedFunds    UnappliedPlayerFunds?

  @@index([status, createdAt])
  @@index([paymentAccountId, bankReference])
  @@index([referenceType, referenceId])
  @@map("bank_transfer_verifications")
}

enum CashReconciliationType {
  OPENING
  CONTROL
  CLOSING
}

enum CashReconciliationStatus {
  DRAFT
  CONFIRMED
  CANCELLED
}

/// Estado de la diferencia, independiente del estado del arqueo.
enum CashDifferenceStatus {
  NOT_REQUIRED
  PENDING
  ADJUSTED
  /// Diferencia de un arqueo de CIERRE sustituida por un recuento o por el
  /// regreso auditado a OPEN (Módulo 12). Sin ajuste; se conserva.
  SUPERSEDED
}

/// Arqueo de EFECTIVO (distinto del arqueo de fichas). OPENING espera
/// siempre $0.00. Confirmado = inmutable; el ajuste es explícito y único.
model CashReconciliation {
  id                      String                   @id @default(cuid())
  cashBoxId               String
  cashBox                 CashBox                  @relation(fields: [cashBoxId], references: [id], onDelete: Restrict)
  sessionId               String
  reconciliationType      CashReconciliationType
  status                  CashReconciliationStatus @default(DRAFT)
  differenceStatus        CashDifferenceStatus     @default(NOT_REQUIRED)
  expectedAmount          Decimal                  @db.Decimal(14, 2)
  countedAmount           Decimal                  @db.Decimal(14, 2)
  differenceAmount        Decimal                  @default(0) @db.Decimal(14, 2)
  /// Versión del saldo de efectivo de la sesión al calcular el esperado.
  balanceVersion          Int
  notes                   String?
  explanation             String?
  adjustmentTransactionId String?                  @unique
  adjustmentTransaction   CashTransaction?         @relation("CashReconciliationAdjustment", fields: [adjustmentTransactionId], references: [id], onDelete: Restrict)
  createdById             String?
  createdBy               User?                    @relation("CashReconciliationCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  confirmedById           String?
  confirmedBy             User?                    @relation("CashReconciliationConfirmedBy", fields: [confirmedById], references: [id], onDelete: SetNull)
  adjustedById            String?
  adjustedBy              User?                    @relation("CashReconciliationAdjustedBy", fields: [adjustedById], references: [id], onDelete: SetNull)
  createdAt               DateTime                 @default(now())
  confirmedAt             DateTime?
  adjustedAt              DateTime?
  cancelledAt             DateTime?

  details CashReconciliationDetail[]

  sessionOpening SessionOpening?

  closureDiscrepancy ClosureDiscrepancy?     @relation("ClosureDiscrepancyCashCount")
  closureWithdrawals ClosureCashWithdrawal[] @relation("ClosureWithdrawalCashCount")
  closureApproval    ClosureApproval?        @relation("ClosureApprovalCashCount")

  @@index([sessionId, reconciliationType])
  @@index([status])
  @@map("cash_reconciliations")
}

/// Desglose opcional del conteo por billete/moneda.
model CashReconciliationDetail {
  id               String             @id @default(cuid())
  reconciliationId String
  reconciliation   CashReconciliation @relation(fields: [reconciliationId], references: [id], onDelete: Restrict)
  unitValue        Decimal            @db.Decimal(12, 2)
  quantity         Int

  @@unique([reconciliationId, unitValue])
  @@map("cash_reconciliation_details")
}

// ── Módulo 06: sesiones y apertura operativa ──────────────────────────

/// Máquina de estados de una sesión. Vigentes: DRAFT, PREPARATION, OPEN,
/// CLOSING (solo una a la vez: índice único parcial). Terminales: CLOSED,
/// CANCELLED. Las transiciones las controla el servicio y un trigger.
enum PokerSessionStatus {
  DRAFT
  PREPARATION
  OPEN
  CLOSING
  CLOSED
  CANCELLED
}

/// Periodo de operación (puede cruzar medianoche). El folio, el creador y
/// las fechas reales los fija el servidor y son inmutables (trigger).
model PokerSession {
  id                   String             @id @default(cuid())
  folio                String             @unique
  cashBoxId            String
  cashBox              CashBox            @relation(fields: [cashBoxId], references: [id], onDelete: Restrict)
  status               PokerSessionStatus @default(DRAFT)
  /// Responsable de la preparación (inmutable): solo él o SUPERADMIN la continúan.
  createdById          String
  createdBy            User               @relation("SessionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  openedById           String?
  openedBy             User?              @relation("SessionOpenedBy", fields: [openedById], references: [id], onDelete: Restrict)
  /// Hora REAL de apertura (servidor, UTC con milisegundos).
  openedAt             DateTime?
  preparationStartedAt DateTime?
  closingStartedAt     DateTime?
  closedAt             DateTime?
  cancelledAt          DateTime?
  cancelledById        String?
  cancelledBy          User?              @relation("SessionCancelledBy", fields: [cancelledById], references: [id], onDelete: Restrict)
  cancellationReason   String?
  notes                String?
  idempotencyKey       String             @unique
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  opening            SessionOpening?
  statusHistory      SessionStatusHistory[]
  tables             SessionTable[]
  participations     TableParticipation[]
  transfers          TableTransfer[]
  purchases          ChipPurchase[]
  debts              PlayerDebt[]
  receivablePayments ReceivablePayment[]
  settlements        PlayerSettlement[]
  settlementPayables SettlementPayable[]    @relation("SettlementPayableSourceSession")
  settlementPayouts  SettlementPayout[]     @relation("SettlementPayoutSession")
  closures           SessionClosure[]
  closureReport      ClosureReport?
  lateRedemptions    LateChipRedemption[]   @relation("RedemptionOriginSession")

  @@index([status])
  @@index([createdAt])
  @@index([createdById])
  @@map("poker_sessions")
}

/// Evidencia inmutable de la apertura: referencia (sin copiar cantidades) al
/// arqueo de fichas OPENING y al arqueo de efectivo OPENING en $0.
model SessionOpening {
  id                     String             @id @default(cuid())
  sessionId              String             @unique
  session                PokerSession       @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  chipStockCountId       String             @unique
  chipStockCount         ChipStockCount     @relation(fields: [chipStockCountId], references: [id], onDelete: Restrict)
  cashReconciliationId   String             @unique
  cashReconciliation     CashReconciliation @relation(fields: [cashReconciliationId], references: [id], onDelete: Restrict)
  confirmedById          String
  confirmedBy            User               @relation("SessionOpeningConfirmedBy", fields: [confirmedById], references: [id], onDelete: Restrict)
  confirmedAt            DateTime           @default(now())
  /// Versión del inventario compartido con la que se abrió.
  inventoryVersion       Int
  /// Siempre $0.00 (CHECK): la caja abre en cero.
  openingCashAmount      Decimal            @default(0) @db.Decimal(14, 2)
  /// SUPERADMIN confirmó una preparación ajena.
  superadminIntervention Boolean            @default(false)
  idempotencyKey         String             @unique

  @@map("session_openings")
}

/// Historial inmutable de cambios de estado de una sesión.
model SessionStatusHistory {
  id          String              @id @default(cuid())
  sessionId   String
  session     PokerSession        @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  fromStatus  PokerSessionStatus?
  toStatus    PokerSessionStatus
  changedById String?
  changedBy   User?               @relation("SessionStatusChangedBy", fields: [changedById], references: [id], onDelete: Restrict)
  changedAt   DateTime            @default(now())
  reason      String?

  @@index([sessionId, changedAt])
  @@map("session_status_history")
}

// ── Módulo 07: mesas dentro de la sesión, ciclos y participación ─────

/// Estado de una mesa dentro de una sesión. CLOSED no es irreversible:
/// puede reabrirse (ciclo nuevo) mientras la sesión siga OPEN.
enum SessionTableStatus {
  PENDING
  OPEN
  CLOSED
}

enum TableCycleStatus {
  OPEN
  CLOSED
}

/// ACTIVE: jugando. TRANSFERRED: se cambió de mesa (conserva sus fichas).
/// SETTLING: dejó de jugar, sus fichas se recibieron y su liquidación está
/// confirmada, pero falta pagarle (todo o parte). No ocupa silla.
/// SETTLED: salida definitiva, SOLO con liquidación terminada (Módulo 11).
enum ParticipationStatus {
  ACTIVE
  TRANSFERRED
  SETTLING
  SETTLED
}

/// Una mesa del catálogo dentro de una sesión (una relación por par). No
/// tiene caja ni inventario propios: comparte la caja central y el
/// inventario de fichas.
model SessionTable {
  id        String             @id @default(cuid())
  sessionId String
  session   PokerSession       @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  tableId   String
  table     PokerTable         @relation(fields: [tableId], references: [id], onDelete: Restrict)
  status    SessionTableStatus @default(PENDING)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  cycles         SessionTableCycle[]
  participations TableParticipation[]
  transfersOut   TableTransfer[]      @relation("TransferSource")
  transfersIn    TableTransfer[]      @relation("TransferDestination")
  purchases      ChipPurchase[]
  settlements    PlayerSettlement[]

  @@unique([sessionId, tableId])
  @@unique([id, sessionId])
  @@index([sessionId, status])
  @@map("session_tables")
}

/// Cada apertura (o reapertura) de una mesa crea un ciclo nuevo; los ciclos
/// cerrados nunca se reabren ni se borran. Guarda una fotografía de ciegas.
model SessionTableCycle {
  id                  String           @id @default(cuid())
  sessionTableId      String
  sessionTable        SessionTable     @relation(fields: [sessionTableId], references: [id], onDelete: Restrict)
  cycleNumber         Int
  status              TableCycleStatus @default(OPEN)
  openedAt            DateTime         @default(now())
  openedById          String
  openedBy            User             @relation("CycleOpenedBy", fields: [openedById], references: [id], onDelete: Restrict)
  closedAt            DateTime?
  closedById          String?
  closedBy            User?            @relation("CycleClosedBy", fields: [closedById], references: [id], onDelete: Restrict)
  closingNotes        String?
  smallBlindSnapshot  Decimal          @db.Decimal(12, 2)
  bigBlindSnapshot    Decimal          @db.Decimal(12, 2)
  openIdempotencyKey  String           @unique
  closeIdempotencyKey String?          @unique
  createdAt           DateTime         @default(now())

  participations TableParticipation[]
  purchases      ChipPurchase[]
  settlements    PlayerSettlement[]

  @@unique([sessionTableId, cycleNumber])
  @@unique([id, sessionTableId])
  @@index([sessionTableId, status])
  @@map("session_table_cycles")
}

/// Participación de un jugador en una mesa (ciclo) de la sesión. Nunca se
/// borra ni se reutiliza: cambiar de mesa o volver tras liquidar crea otra.
model TableParticipation {
  id                    String              @id @default(cuid())
  sessionId             String
  session               PokerSession        @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  sessionTableId        String
  sessionTable          SessionTable        @relation(fields: [sessionTableId, sessionId], references: [id, sessionId], onDelete: Restrict)
  cycleId               String
  cycle                 SessionTableCycle   @relation(fields: [cycleId, sessionTableId], references: [id, sessionTableId], onDelete: Restrict)
  playerId              String
  player                Player              @relation(fields: [playerId], references: [id], onDelete: Restrict)
  status                ParticipationStatus @default(ACTIVE)
  joinedAt              DateTime            @default(now())
  joinedById            String
  joinedBy              User                @relation("ParticipationJoinedBy", fields: [joinedById], references: [id], onDelete: Restrict)
  leftAt                DateTime?
  leftById              String?
  leftBy                User?               @relation("ParticipationLeftBy", fields: [leftById], references: [id], onDelete: Restrict)
  exitReason            String?
  /// Participación de origen cuando llegó por transferencia.
  sourceParticipationId String?             @unique
  /// Liquidación confirmada que finalizó la participación (Módulo 11):
  /// presente en SETTLING (falta pagar) y SETTLED (terminada).
  settlementId          String?             @unique
  settlement            PlayerSettlement?   @relation("ParticipationSettlement", fields: [settlementId], references: [id], onDelete: Restrict)
  idempotencyKey        String              @unique
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  transferOut TableTransfer?     @relation("TransferSourceParticipation")
  transferIn  TableTransfer?     @relation("TransferDestinationParticipation")
  purchases   ChipPurchase[]
  settlements PlayerSettlement[] @relation("SettlementParticipation")

  @@unique([id, sessionId])
  @@index([sessionId, status])
  @@index([sessionTableId, status])
  @@index([playerId])
  @@index([joinedAt])
  @@index([cycleId])
  @@map("table_participations")
}

/// Cambio operativo de mesa: NO mueve fichas ni dinero (el jugador conserva
/// sus fichas). Origen y destino en la misma sesión; solo inserción.
model TableTransfer {
  id                         String             @id @default(cuid())
  sessionId                  String
  session                    PokerSession       @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  playerId                   String
  player                     Player             @relation(fields: [playerId], references: [id], onDelete: Restrict)
  sourceParticipationId      String             @unique
  sourceParticipation        TableParticipation @relation("TransferSourceParticipation", fields: [sourceParticipationId, sessionId], references: [id, sessionId], onDelete: Restrict)
  destinationParticipationId String             @unique
  destinationParticipation   TableParticipation @relation("TransferDestinationParticipation", fields: [destinationParticipationId, sessionId], references: [id, sessionId], onDelete: Restrict)
  sourceSessionTableId       String
  sourceSessionTable         SessionTable       @relation("TransferSource", fields: [sourceSessionTableId, sessionId], references: [id, sessionId], onDelete: Restrict)
  destinationSessionTableId  String
  destinationSessionTable    SessionTable       @relation("TransferDestination", fields: [destinationSessionTableId, sessionId], references: [id, sessionId], onDelete: Restrict)
  transferredById            String
  transferredBy              User               @relation("TransferredBy", fields: [transferredById], references: [id], onDelete: Restrict)
  transferredAt              DateTime           @default(now())
  notes                      String?
  idempotencyKey             String             @unique
  createdAt                  DateTime           @default(now())

  @@unique([sourceParticipationId, sessionId])
  @@unique([destinationParticipationId, sessionId])
  @@index([sessionId, transferredAt])
  @@index([playerId])
  @@map("table_transfers")
}

// ── Módulo 08: compras y recompras por IMPORTE NOMINAL ────────────────
// Ver docs/MODULE_08_PURCHASES.md. Sin desglose por denominación: el
// inventario se descuenta por valor nominal (Módulo 04). El dinero vive en
// el libro de la Caja Central (Módulo 05); aquí solo se guardan las
// referencias. La deuda (PlayerDebt) se deriva de la compra y sus pagos.

/// DRAFT: importe y pagos editables. READY_FOR_DELIVERY: importe apartado
/// (reserva nominal). CONFIRMED: entregada (inmutable). CANCELLED: borrador
/// cancelado. REVERSED: reservado para el reverso completo (Módulos 10/11).
enum ChipPurchaseStatus {
  DRAFT
  READY_FOR_DELIVERY
  CONFIRMED
  CANCELLED
  REVERSED
}

/// Se asigna al CONFIRMAR (los borradores no consumen numeración).
enum ChipPurchaseType {
  INITIAL_PURCHASE
  REBUY
}

/// CASH: CONFIRMED (recibido) o CANCELLED (devuelto antes de entregar).
/// Tarjeta: PENDING → APPROVED | DECLINED; APPROVED → VOIDED (anulada).
/// BANK_TRANSFER: PENDING o CANCELLED; su verificación vive en el Módulo 05.
enum PurchasePaymentStatus {
  PENDING
  CONFIRMED
  APPROVED
  DECLINED
  VOIDED
  CANCELLED
}

/// Cómo comunicó el socio su autorización al cajero (no es aprobación en línea).
enum CreditAuthorizationChannel {
  VERBAL
  MESSAGE
}

enum CreditAuthorizationStatus {
  /// Vigente para la versión de la compra en que se registró.
  ACTIVE
  /// Reemplazada por un cambio material (importe, pagos, socio).
  SUPERSEDED
  /// Usada en la entrega confirmada.
  USED
}

model ChipPurchase {
  id                 String             @id @default(cuid())
  folio              String             @unique
  sessionId          String
  session            PokerSession       @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  sessionTableId     String
  sessionTable       SessionTable       @relation(fields: [sessionTableId], references: [id], onDelete: Restrict)
  cycleId            String
  cycle              SessionTableCycle  @relation(fields: [cycleId], references: [id], onDelete: Restrict)
  participationId    String
  participation      TableParticipation @relation(fields: [participationId], references: [id], onDelete: Restrict)
  playerId           String
  player             Player             @relation(fields: [playerId], references: [id], onDelete: Restrict)
  /// Mesa del catálogo (copia para trazabilidad en caja e inventario).
  tableId            String
  table              PokerTable         @relation(fields: [tableId], references: [id], onDelete: Restrict)
  /// Importe nominal solicitado (Decimal > 0). Sin denominaciones.
  nominalAmount      Decimal            @db.Decimal(14, 2)
  status             ChipPurchaseStatus @default(DRAFT)
  purchaseType       ChipPurchaseType?
  /// Orden de compra confirmada por (sesión, jugador): 1 = compra inicial.
  sequenceNumber     Int?
  /// Recompra 1, 2, 3… (sequenceNumber − 1); null en la compra inicial.
  rebuyNumber        Int?
  /// Versión del resumen: cambia con cada cambio material (firma y
  /// autorización se ligan a una versión exacta).
  version            Int                @default(1)
  /// Reserva nominal vigente (READY_FOR_DELIVERY).
  reservationId      String?            @unique
  notes              String?
  createdById        String
  createdBy          User               @relation("PurchaseCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  confirmedById      String?
  confirmedBy        User?              @relation("PurchaseConfirmedBy", fields: [confirmedById], references: [id], onDelete: Restrict)
  confirmedAt        DateTime?
  cancelledById      String?
  cancelledBy        User?              @relation("PurchaseCancelledBy", fields: [cancelledById], references: [id], onDelete: Restrict)
  cancelledAt        DateTime?
  cancellationReason String?
  idempotencyKey     String             @unique
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  payments         PurchasePayment[]
  authorizations   PurchaseCreditAuthorization[]
  delivery         PurchaseDelivery?
  statusHistory    PurchaseStatusHistory[]
  reversalRequests PurchaseReversalRequest[]
  debt             PlayerDebt?
  signatureSnaps   SignatureSnapshot[]
  signatures       PurchaseSignature[]
  storedFiles      StoredFile[]
  receipt          PurchaseReceipt?
  reversal         PurchaseReversal?

  @@index([sessionId, createdAt])
  @@index([sessionTableId, createdAt])
  @@index([playerId, createdAt])
  @@index([status])
  @@index([createdById])
  @@index([cycleId])
  @@index([confirmedAt])
  @@map("chip_purchases")
}

/// Componente de pago de una compra. El asiento financiero (efectivo o
/// tarjeta) se crea UNA vez al confirmar la entrega; la transferencia queda
/// en verificación manual (Módulo 05). Nunca datos sensibles de tarjeta.
model PurchasePayment {
  id                     String                    @id @default(cuid())
  purchaseId             String
  purchase               ChipPurchase              @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  method                 PaymentMethodCode
  amount                 Decimal                   @db.Decimal(14, 2)
  status                 PurchasePaymentStatus
  /// Folio/autorización de la terminal (texto operativo, nunca datos de tarjeta).
  terminalReference      String?
  /// Identificador de la terminal física, si se conoce.
  terminalIdentifier     String?
  /// Referencia bancaria declarada (transferencias).
  externalReference      String?
  bankTransferId         String?                   @unique
  bankTransfer           BankTransferVerification? @relation(fields: [bankTransferId], references: [id], onDelete: Restrict)
  /// Asiento al confirmar la entrega (único: no se contabiliza dos veces).
  financialTransactionId String?                   @unique
  financialTransaction   CashTransaction?          @relation("PurchasePaymentTransaction", fields: [financialTransactionId], references: [id], onDelete: Restrict)
  /// Aplicaciones a la deuda de su compra (transferencia verificada después de entregar).
  allocations            PaymentAllocation[]
  unappliedFunds         UnappliedPlayerFunds[]
  /// Depósito de la terminal que liquidó este cobro (una sola vez).
  cardSettlementId       String?
  cardSettlement         CardTerminalSettlement?   @relation(fields: [cardSettlementId], references: [id], onDelete: Restrict)
  resolutionNotes        String?
  createdById            String
  createdBy              User                      @relation("PurchasePaymentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt              DateTime                  @default(now())
  resolvedById           String?
  resolvedBy             User?                     @relation("PurchasePaymentResolvedBy", fields: [resolvedById], references: [id], onDelete: Restrict)
  resolvedAt             DateTime?
  idempotencyKey         String                    @unique
  updatedAt              DateTime                  @updatedAt

  @@index([purchaseId])
  @@index([method, status])
  @@index([cardSettlementId])
  @@map("purchase_payments")
}

/// Registro operativo de la autorización de crédito que un SOCIO comunicó
/// al cajero (verbal o por mensaje). No es una aprobación en línea.
model PurchaseCreditAuthorization {
  id                     String                     @id @default(cuid())
  purchaseId             String
  purchase               ChipPurchase               @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  authorizedByPartnerId  String
  authorizedByPartner    User                       @relation("CreditAuthorizedByPartner", fields: [authorizedByPartnerId], references: [id], onDelete: Restrict)
  /// Nombre del socio al momento (histórico para auditoría).
  partnerNameSnapshot    String
  authorizationChannel   CreditAuthorizationChannel
  /// Calculado por el servidor (saldo por cobrar al registrar).
  authorizedCreditAmount Decimal                    @db.Decimal(14, 2)
  /// Versión de la compra a la que corresponde.
  purchaseVersion        Int
  notes                  String?
  status                 CreditAuthorizationStatus  @default(ACTIVE)
  recordedById           String
  recordedBy             User                       @relation("CreditAuthorizationRecordedBy", fields: [recordedById], references: [id], onDelete: Restrict)
  recordedAt             DateTime                   @default(now())
  idempotencyKey         String                     @unique

  debt PlayerDebt?

  @@index([purchaseId, status])
  @@index([authorizedByPartnerId])
  @@map("purchase_credit_authorizations")
}

/// Entrega física confirmada (una por compra, inmutable): referencia al
/// movimiento NOMINAL de inventario y, si hubo crédito, a la firma (Módulo 09).
model PurchaseDelivery {
  id                   String             @id @default(cuid())
  purchaseId           String             @unique
  purchase             ChipPurchase       @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  nominalAmount        Decimal            @db.Decimal(14, 2)
  inventoryOperationId String             @unique
  reservationId        String             @unique
  /// Pagos confirmados y saldo por cobrar al momento de la entrega.
  confirmedPayments    Decimal            @db.Decimal(14, 2)
  pendingTransfers     Decimal            @db.Decimal(14, 2)
  outstandingAmount    Decimal            @db.Decimal(14, 2)
  summaryVersion       Int
  summaryHash          String
  /// Firma auténtica verificada por el Módulo 09 (obligatoria si hay crédito).
  signatureId          String?            @unique
  signature            PurchaseSignature? @relation(fields: [signatureId], references: [id], onDelete: Restrict)
  deliveredById        String
  deliveredBy          User               @relation("PurchaseDeliveredBy", fields: [deliveredById], references: [id], onDelete: Restrict)
  deliveredAt          DateTime           @default(now())
  idempotencyKey       String             @unique

  receipt PurchaseReceipt?

  @@map("purchase_deliveries")
}

model PurchaseStatusHistory {
  id          String              @id @default(cuid())
  purchaseId  String
  purchase    ChipPurchase        @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  fromStatus  ChipPurchaseStatus?
  toStatus    ChipPurchaseStatus
  changedById String
  changedBy   User                @relation("PurchaseStatusChangedBy", fields: [changedById], references: [id], onDelete: Restrict)
  changedAt   DateTime            @default(now())
  reason      String?

  @@index([purchaseId, changedAt])
  @@map("purchase_status_history")
}

enum PurchaseReversalStatus {
  /// Solicitud registrada; la ejecución requiere los Módulos 10 y 11.
  REQUESTED
}

/// Solicitud justificada de reverso de una compra confirmada. NO mueve
/// fichas ni dinero: el reverso completo exige devolución física real,
/// reembolsos y verificar abonos/liquidaciones (pendiente).
model PurchaseReversalRequest {
  id             String                 @id @default(cuid())
  purchaseId     String
  purchase       ChipPurchase           @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  reason         String
  status         PurchaseReversalStatus @default(REQUESTED)
  requestedById  String
  requestedBy    User                   @relation("PurchaseReversalRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)
  requestedAt    DateTime               @default(now())
  idempotencyKey String                 @unique

  @@index([purchaseId])
  @@map("purchase_reversal_requests")
}

/// Deuda de un jugador originada por una compra entregada con saldo por
/// cobrar (infraestructura mínima para el Módulo 10). Inmutable: el saldo
/// vigente se DERIVA (importe original − pagos confirmados posteriores);
/// nunca hay un campo de saldo editable.
model PlayerDebt {
  id              String                      @id @default(cuid())
  playerId        String
  player          Player                      @relation(fields: [playerId], references: [id], onDelete: Restrict)
  sessionId       String
  session         PokerSession                @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  tableId         String
  purchaseId      String                      @unique
  purchase        ChipPurchase                @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  authorizationId String                      @unique
  authorization   PurchaseCreditAuthorization @relation(fields: [authorizationId], references: [id], onDelete: Restrict)
  originalAmount  Decimal                     @db.Decimal(14, 2)
  createdById     String
  createdBy       User                        @relation("PlayerDebtCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt       DateTime                    @default(now())

  /// Libro de aplicaciones (Módulo 10): el saldo se DERIVA de aquí.
  allocations PaymentAllocation[]

  @@index([playerId, createdAt])
  @@index([sessionId])
  @@index([createdAt])
  @@index([tableId])
  @@map("player_debts")
}

enum NotificationEventType {
  PURCHASE_CREDIT_CONFIRMED
}

enum NotificationOutboxStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

/// Eventos persistentes para notificaciones futuras (Módulo 13). Este
/// módulo NO envía nada: solo registra el evento (deduplicado). El envío
/// verificará consentimiento vigente, canal configurado y elegibilidad.
model NotificationOutbox {
  id            String                   @id @default(cuid())
  eventType     NotificationEventType
  channel       NotificationChannel      @default(WHATSAPP)
  playerId      String
  player        Player                   @relation(fields: [playerId], references: [id], onDelete: Restrict)
  aggregateType String
  aggregateId   String
  /// Datos del evento (sin teléfonos, tokens ni secretos).
  payload       Json
  status        NotificationOutboxStatus @default(PENDING)
  /// Un evento por hecho de negocio (reintentos no duplican).
  dedupeKey     String                   @unique
  attempts      Int                      @default(0)
  lastError     String?
  createdAt     DateTime                 @default(now())
  processedAt   DateTime?

  @@index([status, createdAt])
  @@index([aggregateType, aggregateId])
  @@map("notification_outbox")
}

enum CardSettlementStatus {
  /// El depósito cubrió el bruto de los cobros.
  RECONCILED
  /// El depósito fue menor (p. ej. comisión no configurada): la diferencia
  /// queda por conciliar en la cuenta de cobros por liquidar.
  DIFFERENCE_PENDING
}

/// Depósito de la terminal al banco que liquida cobros APROBADOS. No
/// reconoce la venta otra vez: mueve de "por liquidar" a "banco".
model CardTerminalSettlement {
  id                String               @id @default(cuid())
  grossAmount       Decimal              @db.Decimal(14, 2)
  depositedAmount   Decimal              @db.Decimal(14, 2)
  pendingDifference Decimal              @db.Decimal(14, 2)
  status            CardSettlementStatus
  bankReference     String?
  notes             String?
  transactionId     String               @unique
  transaction       CashTransaction      @relation("CardSettlementTransaction", fields: [transactionId], references: [id], onDelete: Restrict)
  createdById       String
  createdBy         User                 @relation("CardSettlementCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt         DateTime             @default(now())
  idempotencyKey    String               @unique

  payments           PurchasePayment[]
  receivablePayments ReceivablePayment[]

  @@index([createdAt])
  @@map("card_terminal_settlements")
}

// ── Módulo 09: firmas de reconocimiento de crédito y comprobantes ─────
// Ver docs/MODULE_09_SIGNATURES_RECEIPTS.md. Una firma NO entrega fichas
// ni crea deuda: solo es evidencia de que el jugador aceptó un resumen
// exacto e inmutable. La entrega la confirma el cajero (Módulo 08).

/// Documento EXACTO que se mostró al jugador antes de firmar (inmutable).
/// No es fuente de verdad del saldo actual: es historia.
model SignatureSnapshot {
  id                      String                     @id @default(cuid())
  purchaseId              String
  purchase                ChipPurchase               @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  playerId                String
  player                  Player                     @relation(fields: [playerId], references: [id], onDelete: Restrict)
  playerNameSnapshot      String
  sessionId               String
  sessionFolioSnapshot    String
  tableId                 String
  tableNameSnapshot       String
  purchaseFolio           String
  /// Tipo y número PROYECTADOS (se verifican contra los asignados al entregar).
  purchaseType            ChipPurchaseType
  rebuyNumber             Int?
  nominalAmount           Decimal                    @db.Decimal(14, 2)
  confirmedPaymentsAmount Decimal                    @db.Decimal(14, 2)
  pendingTransferAmount   Decimal                    @db.Decimal(14, 2)
  outstandingCreditAmount Decimal                    @db.Decimal(14, 2)
  /// Componentes confirmados mostrados (método e importe, sin datos de tarjeta).
  paymentsSnapshot        Json
  creditAuthorizationId   String
  authorizedByPartnerId   String
  authorizedByPartner     User                       @relation("SnapshotPartner", fields: [authorizedByPartnerId], references: [id], onDelete: Restrict)
  partnerNameSnapshot     String
  authorizationChannel    CreditAuthorizationChannel
  declarationText         String
  declarationVersion      String
  purchaseVersion         Int
  preparedAt              DateTime
  preparedById            String
  preparedBy              User                       @relation("SnapshotPreparedBy", fields: [preparedById], references: [id], onDelete: Restrict)
  /// SHA-256 del contenido canónico (sin fecha de preparación): detecta cambios materiales.
  contentHash             String
  /// SHA-256 canónico de TODO lo mostrado (incluida la fecha): integridad.
  payloadHash             String                     @unique

  signature PurchaseSignature?

  @@unique([purchaseId, contentHash])
  @@index([purchaseId, preparedAt])
  @@map("signature_snapshots")
}

enum PurchaseSignatureStatus {
  VALID
  /// Cambio material antes de entregar (se conserva como evidencia).
  INVALIDATED
  /// La compra se canceló.
  CANCELLED
}

/// Firma del jugador capturada en el dispositivo del cajero. Una por
/// snapshot (no se reutiliza); una sola VALID por compra. La imagen se
/// guarda en almacenamiento privado (StoredFile) y nunca se sustituye.
model PurchaseSignature {
  id                 String                  @id @default(cuid())
  purchaseId         String
  purchase           ChipPurchase            @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  playerId           String
  player             Player                  @relation(fields: [playerId], references: [id], onDelete: Restrict)
  snapshotId         String                  @unique
  snapshot           SignatureSnapshot       @relation(fields: [snapshotId], references: [id], onDelete: Restrict)
  fileId             String                  @unique
  file               StoredFile              @relation(fields: [fileId], references: [id], onDelete: Restrict)
  /// SHA-256 del PNG almacenado.
  imageHash          String
  status             PurchaseSignatureStatus @default(VALID)
  signedAt           DateTime
  capturedById       String
  capturedBy         User                    @relation("SignatureCapturedBy", fields: [capturedById], references: [id], onDelete: Restrict)
  invalidatedAt      DateTime?
  invalidatedById    String?
  invalidatedBy      User?                   @relation("SignatureInvalidatedBy", fields: [invalidatedById], references: [id], onDelete: Restrict)
  invalidationReason String?
  idempotencyKey     String                  @unique
  createdAt          DateTime                @default(now())

  delivery PurchaseDelivery?
  receipt  PurchaseReceipt?

  @@index([purchaseId, status])
  @@map("purchase_signatures")
}

enum StoredFileStatus {
  /// Subido, aún no ligado a un registro (estado transitorio).
  PENDING
  /// Evidencia definitiva (inmutable).
  ACTIVE
  /// Nunca se ligó (falló la transacción): candidato a limpieza controlada.
  ORPHANED
}

enum StoredFilePurpose {
  PURCHASE_SIGNATURE
  SETTLEMENT_SIGNATURE
  /// Módulo 16: aceptación firmada de un canje o una corrección.
  SPECIAL_OPERATION_SIGNATURE
}

/// Metadatos de un archivo privado. El contenido vive en el adaptador de
/// almacenamiento (por defecto, `evidence_blobs` en PostgreSQL); nunca en
/// una carpeta pública ni con URL pública.
model StoredFile {
  id           String            @id @default(cuid())
  driver       String
  /// Clave privada (aleatoria, no enumerable). Nunca se expone al cliente.
  storageKey   String            @unique
  purpose      StoredFilePurpose
  mimeType     String
  sizeBytes    Int
  sha256       String
  status       StoredFileStatus  @default(PENDING)
  purchaseId   String?
  purchase     ChipPurchase?     @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  /// Firma de liquidación (Módulo 11).
  settlementId String?
  settlement   PlayerSettlement? @relation(fields: [settlementId], references: [id], onDelete: Restrict)
  createdById  String
  createdBy    User              @relation("StoredFileCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt    DateTime          @default(now())
  promotedAt   DateTime?
  orphanedAt   DateTime?

  signature           PurchaseSignature?
  settlementSignature SettlementSignature?
  specialEvidence     SpecialOperationEvidence? @relation("SpecialEvidenceFile")

  @@index([status, createdAt])
  @@map("stored_files")
}

/// Contenido binario del almacenamiento privado en PostgreSQL. Solo se
/// lee desde el servidor tras autorizar; nunca se sirve públicamente.
model EvidenceBlob {
  storageKey String   @id
  bytes      Bytes
  createdAt  DateTime @default(now())

  @@map("evidence_blobs")
}

enum ReceiptStatus {
  AVAILABLE
  VOIDED
}

/// Comprobante DIGITAL de una compra confirmada (no PDF). Su contenido es
/// un snapshot inmutable tomado al confirmar la entrega; los pagos
/// posteriores no lo modifican. Solo puede pasar a VOIDED (reverso).
model PurchaseReceipt {
  id            String             @id @default(cuid())
  purchaseId    String             @unique
  purchase      ChipPurchase       @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  deliveryId    String             @unique
  delivery      PurchaseDelivery   @relation(fields: [deliveryId], references: [id], onDelete: Restrict)
  signatureId   String?            @unique
  signature     PurchaseSignature? @relation(fields: [signatureId], references: [id], onDelete: Restrict)
  status        ReceiptStatus      @default(AVAILABLE)
  content       Json
  contentHash   String
  createdById   String
  createdBy     User               @relation("ReceiptCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt     DateTime           @default(now())
  voidedAt      DateTime?
  voidedById    String?
  voidedBy      User?              @relation("ReceiptVoidedBy", fields: [voidedById], references: [id], onDelete: Restrict)
  voidReason    String?
  voidReference String?

  @@index([status])
  @@map("purchase_receipts")
}

// ── Módulo 10: créditos, abonos y aplicación FIFO ─────────────────────
// Ver docs/MODULE_10_CREDITS.md. La cuenta por cobrar es `PlayerDebt`
// (creada por el Módulo 08 al confirmar una entrega con crédito). Su saldo
// se DERIVA: importe original − aplicaciones + reversos de aplicaciones.
// El dinero vive en el libro del Módulo 05 (sin libros paralelos).

enum ReceivablePaymentOrigin {
  /// Cobrado durante una sesión OPEN (el efectivo entra a su caja).
  SESSION
  /// Fuera de sesión: el efectivo va a custodia administrativa; nunca a una caja cerrada.
  ADMINISTRATIVE
}

enum ReceivablePaymentStatus {
  /// Transferencia anunciada sin verificar (no reduce deuda).
  PENDING
  CONFIRMED
  /// Transferencia rechazada en el banco o cobro de terminal rechazado.
  REJECTED
  /// Revertido con contraasientos (el original se conserva).
  REVERSED
}

/// Abono general de un jugador (no es un pago de compra: esos viven en
/// PurchasePayment). Se aplica por FIFO a sus deudas.
model ReceivablePayment {
  id                     String                    @id @default(cuid())
  folio                  String                    @unique
  playerId               String
  player                 Player                    @relation(fields: [playerId], references: [id], onDelete: Restrict)
  amount                 Decimal                   @db.Decimal(14, 2)
  method                 PaymentMethodCode
  origin                 ReceivablePaymentOrigin
  /// Sesión OPEN donde se cobró (solo SESSION).
  sessionId              String?
  session                PokerSession?             @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  status                 ReceivablePaymentStatus
  /// Asiento del cobro (único: no se contabiliza dos veces).
  financialTransactionId String?                   @unique
  financialTransaction   CashTransaction?          @relation("ReceivablePaymentTransaction", fields: [financialTransactionId], references: [id], onDelete: Restrict)
  bankTransferId         String?                   @unique
  bankTransfer           BankTransferVerification? @relation(fields: [bankTransferId], references: [id], onDelete: Restrict)
  /// Efectivo administrativo: quién lo custodia.
  custodianUserId        String?
  custodian              User?                     @relation("ReceivablePaymentCustodian", fields: [custodianUserId], references: [id], onDelete: Restrict)
  terminalReference      String?
  terminalIdentifier     String?
  externalReference      String?
  cardSettlementId       String?
  cardSettlement         CardTerminalSettlement?   @relation(fields: [cardSettlementId], references: [id], onDelete: Restrict)
  notes                  String?
  createdById            String
  createdBy              User                      @relation("ReceivablePaymentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  confirmedById          String?
  confirmedBy            User?                     @relation("ReceivablePaymentConfirmedBy", fields: [confirmedById], references: [id], onDelete: Restrict)
  createdAt              DateTime                  @default(now())
  confirmedAt            DateTime?
  rejectedAt             DateTime?
  reversedAt             DateTime?
  idempotencyKey         String                    @unique
  updatedAt              DateTime                  @updatedAt

  allocations    PaymentAllocation[]
  reversal       ReceivablePaymentReversal?
  receipt        ReceivablePaymentReceipt?
  unappliedFunds UnappliedPlayerFunds[]

  @@index([playerId, createdAt])
  @@index([status, createdAt])
  @@index([origin, createdAt])
  @@index([cardSettlementId])
  @@index([sessionId])
  @@map("receivable_payments")
}

enum AllocationSource {
  /// Abono general (FIFO).
  RECEIVABLE_PAYMENT
  /// Pago de la propia compra (transferencia anunciada en la compra y
  /// verificada después de la entrega): se aplica a SU deuda, sin FIFO.
  PURCHASE_PAYMENT
  /// Compensación con fichas (Módulo 11): sin dinero.
  CHIP_SETTLEMENT_OFFSET
  /// Módulo 16: extinción NO monetaria del saldo de una deuda por el reverso
  /// de su compra (las fichas regresaron físicamente). No es un pago.
  PURCHASE_REVERSAL
}

enum AllocationKind {
  APPLICATION
  /// Contraasiento de una aplicación (reverso); la original se conserva.
  REVERSAL
}

/// Libro INMUTABLE de aplicaciones a deudas. Saldo de una deuda =
/// original − Σ APPLICATION + Σ REVERSAL (la base impide exceder el
/// original o el importe del pago).
model PaymentAllocation {
  id                   String             @id @default(cuid())
  receivableId         String
  receivable           PlayerDebt         @relation(fields: [receivableId], references: [id], onDelete: Restrict)
  playerId             String
  player               Player             @relation(fields: [playerId], references: [id], onDelete: Restrict)
  kind                 AllocationKind     @default(APPLICATION)
  source               AllocationSource
  amount               Decimal            @db.Decimal(14, 2)
  /// Orden FIFO dentro de la operación (1, 2, 3…).
  allocationOrder      Int
  receivablePaymentId  String?
  receivablePayment    ReceivablePayment? @relation(fields: [receivablePaymentId], references: [id], onDelete: Restrict)
  purchasePaymentId    String?
  purchasePayment      PurchasePayment?   @relation(fields: [purchasePaymentId], references: [id], onDelete: Restrict)
  /// Liquidación de fichas del Módulo 11 (compensación con fichas).
  settlementId         String?
  settlement           PlayerSettlement?  @relation(fields: [settlementId], references: [id], onDelete: Restrict)
  /// Módulo 16: extinción por reverso de la compra (sin dinero).
  purchaseReversalId   String?
  purchaseReversal     PurchaseReversal?  @relation("ReversalExtinctions", fields: [purchaseReversalId], references: [id], onDelete: Restrict)
  reversesAllocationId String?            @unique
  reverses             PaymentAllocation? @relation("AllocationReversal", fields: [reversesAllocationId], references: [id], onDelete: Restrict)
  reversedBy           PaymentAllocation? @relation("AllocationReversal")
  createdById          String
  createdBy            User               @relation("AllocationCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  allocatedAt          DateTime           @default(now())

  @@index([receivableId])
  @@index([playerId, allocatedAt])
  @@index([receivablePaymentId])
  @@index([purchasePaymentId])
  @@index([settlementId])
  @@index([source, allocatedAt])
  @@map("payment_allocations")
}

/// Reverso auditado de un abono confirmado (contraasientos de dinero y de
/// aplicaciones). El abono y sus aplicaciones originales se conservan.
model ReceivablePaymentReversal {
  id             String            @id @default(cuid())
  paymentId      String            @unique
  payment        ReceivablePayment @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  reason         String
  transactionId  String?           @unique
  transaction    CashTransaction?  @relation("ReceivableReversalTransaction", fields: [transactionId], references: [id], onDelete: Restrict)
  createdById    String
  createdBy      User              @relation("PaymentReversalCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt      DateTime          @default(now())
  idempotencyKey String            @unique

  @@map("receivable_payment_reversals")
}

enum UnappliedFundsStatus {
  /// Recibido sin deuda a la cual aplicarlo: pendiente de devolución o conciliación.
  PENDING_RESOLUTION
}

/// Dinero REAL recibido (transferencia verificada) que excede la deuda del
/// jugador. No es saldo a favor ni se aplica a compras futuras.
model UnappliedPlayerFunds {
  id                  String                   @id @default(cuid())
  playerId            String
  player              Player                   @relation(fields: [playerId], references: [id], onDelete: Restrict)
  amount              Decimal                  @db.Decimal(14, 2)
  status              UnappliedFundsStatus     @default(PENDING_RESOLUTION)
  reason              String
  bankTransferId      String                   @unique
  bankTransfer        BankTransferVerification @relation(fields: [bankTransferId], references: [id], onDelete: Restrict)
  receivablePaymentId String?
  receivablePayment   ReceivablePayment?       @relation(fields: [receivablePaymentId], references: [id], onDelete: Restrict)
  purchasePaymentId   String?
  purchasePayment     PurchasePayment?         @relation(fields: [purchasePaymentId], references: [id], onDelete: Restrict)
  createdById         String
  createdBy           User                     @relation("UnappliedFundsCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt           DateTime                 @default(now())

  @@index([playerId])
  @@map("unapplied_player_funds")
}

/// Depósito al banco de efectivo administrativo en custodia (traslado:
/// custodia − / banco +). No es un abono nuevo ni un ingreso adicional.
model AdministrativeCashDeposit {
  id              String          @id @default(cuid())
  custodianUserId String
  custodian       User            @relation("CustodyDepositCustodian", fields: [custodianUserId], references: [id], onDelete: Restrict)
  amount          Decimal         @db.Decimal(14, 2)
  bankReference   String?
  notes           String?
  transactionId   String          @unique
  transaction     CashTransaction @relation("CustodyDepositTransaction", fields: [transactionId], references: [id], onDelete: Restrict)
  createdById     String
  createdBy       User            @relation("CustodyDepositCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt       DateTime        @default(now())
  idempotencyKey  String          @unique

  @@index([custodianUserId, createdAt])
  @@map("administrative_cash_deposits")
}

/// Comprobante digital de un abono confirmado (snapshot inmutable). Mismo
/// esquema que los comprobantes de compra (Módulo 09): PNG, sin PDF.
model ReceivablePaymentReceipt {
  id          String            @id @default(cuid())
  paymentId   String            @unique
  payment     ReceivablePayment @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  status      ReceiptStatus     @default(AVAILABLE)
  content     Json
  contentHash String
  createdById String
  createdBy   User              @relation("CreditReceiptCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime          @default(now())
  voidedAt    DateTime?
  voidReason  String?

  @@map("receivable_payment_receipts")
}

/// Efectivo REAL que un socio/propietario entrega a un custodio para pagos
/// administrativos (Módulo 11): aportación documentada a la custodia
/// (OWNER_CONTRIBUTIONS → ADMIN_CASH_CUSTODY). Nunca toca cajas de sesión.
model AdministrativeCashContribution {
  id               String          @id @default(cuid())
  custodianUserId  String
  custodian        User            @relation("CustodyContributionCustodian", fields: [custodianUserId], references: [id], onDelete: Restrict)
  amount           Decimal         @db.Decimal(14, 2)
  /// Quién entregó físicamente el dinero (socio o propietario).
  counterpartyName String
  reason           String
  transactionId    String          @unique
  transaction      CashTransaction @relation("CustodyContributionTransaction", fields: [transactionId], references: [id], onDelete: Restrict)
  createdById      String
  createdBy        User            @relation("CustodyContributionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt        DateTime        @default(now())
  idempotencyKey   String          @unique

  @@index([custodianUserId, createdAt])
  @@map("administrative_cash_contributions")
}

// ── Módulo 11: liquidaciones de jugadores ─────────────────────────────
// Ver docs/MODULE_11_SETTLEMENTS.md. Devolución de fichas por IMPORTE
// NOMINAL (sin denominaciones), compensación de deuda OPCIONAL (decisión
// explícita del cajero; si compensa, FIFO automático del Módulo 10), firma
// obligatoria en TODAS las liquidaciones, cuenta por pagar al jugador y
// desembolsos (efectivo, transferencia saliente o mixtos). El dinero vive
// en el libro del Módulo 05; aquí solo hay referencias.

/// DRAFT: editable, sin efectos. READY_FOR_CONFIRMATION: resumen firmado
/// (VALID) vigente. PENDING_PAYOUT: fichas recibidas, compensación aplicada
/// y falta pagar. COMPLETED: pagada (o neto $0). CANCELLED: borrador
/// cancelado. REVERSED: reverso legítimo con contraasientos.
enum PlayerSettlementStatus {
  DRAFT
  READY_FOR_CONFIRMATION
  PENDING_PAYOUT
  COMPLETED
  CANCELLED
  REVERSED
}

/// Decisión EXPLÍCITA del cajero (nunca implícita por existir deuda).
enum SettlementOffsetDecision {
  NO_COMPENSATE
  PARTIAL
  MAXIMUM
}

enum SettlementSignatureStatus {
  VALID
  /// Cambio material antes de recibir las fichas (se conserva).
  INVALIDATED
  /// La liquidación se canceló.
  CANCELLED
}

/// Estado DERIVADO del libro de desembolsos (proyección mantenida en la
/// misma transacción; nunca editable desde la API).
enum SettlementPayableStatus {
  OPEN
  PARTIALLY_PAID
  PAID
  VOIDED
}

enum SettlementPayoutMethod {
  CASH
  BANK_TRANSFER
}

/// PENDING solo para transferencias (reserva el importe). EXECUTED cuenta
/// como pagado. FAILED/CANCELLED liberan la reserva y no cuentan.
enum SettlementPayoutStatus {
  PENDING
  EXECUTED
  FAILED
  CANCELLED
}

/// De dónde sale el dinero (lo decide el servidor).
enum SettlementPayoutFunding {
  /// Efectivo de la caja de la sesión de origen (OPEN/CLOSING).
  SESSION_CASH
  /// Efectivo administrativo bajo custodia (sesión ya cerrada).
  ADMIN_CUSTODY
  /// Cuenta bancaria (transferencia saliente verificada manualmente).
  BANK
}

enum SettlementReceiptKind {
  /// Recepción de fichas y liquidación (uno por liquidación).
  RECEPTION
  /// Anexo por cada desembolso ejecutado.
  PAYOUT
}

model PlayerSettlement {
  id                    String                   @id @default(cuid())
  folio                 String                   @unique
  sessionId             String
  session               PokerSession             @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  sessionTableId        String
  sessionTable          SessionTable             @relation(fields: [sessionTableId], references: [id], onDelete: Restrict)
  cycleId               String
  cycle                 SessionTableCycle        @relation(fields: [cycleId], references: [id], onDelete: Restrict)
  /// Participación ACTIVE FINAL (la mesa actual, aunque comprara en otra).
  participationId       String
  participation         TableParticipation       @relation("SettlementParticipation", fields: [participationId], references: [id], onDelete: Restrict)
  playerId              String
  player                Player                   @relation(fields: [playerId], references: [id], onDelete: Restrict)
  /// Mesa del catálogo (copia para trazabilidad).
  tableId               String
  table                 PokerTable               @relation(fields: [tableId], references: [id], onDelete: Restrict)
  /// Valor nominal TOTAL devuelto (≥ 0). Sin denominaciones.
  returnedNominalAmount Decimal                  @db.Decimal(14, 2)
  offsetDecision        SettlementOffsetDecision
  /// Importe pedido por el cajero (solo PARTIAL).
  requestedOffsetAmount Decimal?                 @db.Decimal(14, 2)
  /// Fijados al CONFIRMAR la recepción (recalculados en el servidor).
  debtBalanceSnapshot   Decimal?                 @db.Decimal(14, 2)
  offsetAmount          Decimal?                 @db.Decimal(14, 2)
  netPayoutAmount       Decimal?                 @db.Decimal(14, 2)
  /// Versión del resumen: cambia con cada cambio material (la firma se liga a una versión).
  version               Int                      @default(1)
  status                PlayerSettlementStatus   @default(DRAFT)
  /// Operación nominal de entrada (solo si se devolvió > 0).
  chipReturnOperationId String?                  @unique
  /// Firma VALID verificada al confirmar.
  signatureId           String?                  @unique
  signature             SettlementSignature?     @relation("SettlementConfirmedSignature", fields: [signatureId], references: [id], onDelete: Restrict)
  notes                 String?
  createdById           String
  createdBy             User                     @relation("SettlementCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  receivedById          String?
  receivedBy            User?                    @relation("SettlementReceivedBy", fields: [receivedById], references: [id], onDelete: Restrict)
  receivedAt            DateTime?
  completedAt           DateTime?
  cancelledById         String?
  cancelledBy           User?                    @relation("SettlementCancelledBy", fields: [cancelledById], references: [id], onDelete: Restrict)
  cancelledAt           DateTime?
  cancellationReason    String?
  reversedAt            DateTime?
  idempotencyKey        String                   @unique
  confirmIdempotencyKey String?                  @unique
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt

  finalizedParticipation TableParticipation?           @relation("ParticipationSettlement")
  statusHistory          SettlementStatusHistory[]
  snapshots              SettlementSignatureSnapshot[]
  signatures             SettlementSignature[]         @relation("SettlementSignatures")
  storedFiles            StoredFile[]
  allocations            PaymentAllocation[]
  payable                SettlementPayable?
  payouts                SettlementPayout[]
  receipts               SettlementReceipt[]
  reversal               SettlementReversal?
  corrections            SettlementCorrection[]        @relation("SettlementCorrections")

  @@index([sessionId, createdAt])
  @@index([playerId, createdAt])
  @@index([participationId])
  @@index([status])
  @@index([cycleId])
  @@map("player_settlements")
}

model SettlementStatusHistory {
  id           String                  @id @default(cuid())
  settlementId String
  settlement   PlayerSettlement        @relation(fields: [settlementId], references: [id], onDelete: Restrict)
  fromStatus   PlayerSettlementStatus?
  toStatus     PlayerSettlementStatus
  changedById  String
  changedBy    User                    @relation("SettlementStatusChangedBy", fields: [changedById], references: [id], onDelete: Restrict)
  changedAt    DateTime                @default(now())
  reason       String?

  @@index([settlementId, changedAt])
  @@map("settlement_status_history")
}

/// Documento EXACTO que se mostró al jugador (inmutable). `content` es el
/// JSON canónico preparado por el servidor; `materialHash` cubre lo que
/// compromete (importes, decisión, distribución FIFO, versión).
model SettlementSignatureSnapshot {
  id                 String           @id @default(cuid())
  settlementId       String
  settlement         PlayerSettlement @relation(fields: [settlementId], references: [id], onDelete: Restrict)
  playerId           String
  player             Player           @relation(fields: [playerId], references: [id], onDelete: Restrict)
  settlementVersion  Int
  content            Json
  declarationText    String
  declarationVersion String
  preparedAt         DateTime
  preparedById       String
  preparedBy         User             @relation("SettlementSnapshotPreparedBy", fields: [preparedById], references: [id], onDelete: Restrict)
  /// SHA-256 del contenido mostrado (sin fecha de preparación).
  contentHash        String
  /// SHA-256 de la parte material (se verifica al confirmar la recepción).
  materialHash       String
  /// SHA-256 de TODO lo mostrado (incluida la fecha): integridad.
  payloadHash        String           @unique

  signature SettlementSignature?

  @@unique([settlementId, contentHash])
  @@index([settlementId, preparedAt])
  @@map("settlement_signature_snapshots")
}

/// Firma del jugador en el dispositivo del cajero. Una por snapshot, una
/// sola VALID por liquidación; nunca se reutiliza ni se borra.
model SettlementSignature {
  id                 String                      @id @default(cuid())
  settlementId       String
  settlement         PlayerSettlement            @relation("SettlementSignatures", fields: [settlementId], references: [id], onDelete: Restrict)
  playerId           String
  player             Player                      @relation(fields: [playerId], references: [id], onDelete: Restrict)
  snapshotId         String                      @unique
  snapshot           SettlementSignatureSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Restrict)
  fileId             String                      @unique
  file               StoredFile                  @relation(fields: [fileId], references: [id], onDelete: Restrict)
  imageHash          String
  status             SettlementSignatureStatus   @default(VALID)
  signedAt           DateTime
  capturedById       String
  capturedBy         User                        @relation("SettlementSignatureCapturedBy", fields: [capturedById], references: [id], onDelete: Restrict)
  invalidatedAt      DateTime?
  invalidatedById    String?
  invalidatedBy      User?                       @relation("SettlementSignatureInvalidatedBy", fields: [invalidatedById], references: [id], onDelete: Restrict)
  invalidationReason String?
  idempotencyKey     String                      @unique
  createdAt          DateTime                    @default(now())

  confirmedSettlement PlayerSettlement? @relation("SettlementConfirmedSignature")

  @@index([settlementId, status])
  @@map("settlement_signatures")
}

/// Cuenta POR PAGAR al jugador (no es la deuda del jugador). Saldo
/// pendiente = original − desembolsos EXECUTED (derivado, nunca editable).
model SettlementPayable {
  id              String                  @id @default(cuid())
  settlementId    String                  @unique
  settlement      PlayerSettlement        @relation(fields: [settlementId], references: [id], onDelete: Restrict)
  playerId        String
  player          Player                  @relation(fields: [playerId], references: [id], onDelete: Restrict)
  sourceSessionId String
  sourceSession   PokerSession            @relation("SettlementPayableSourceSession", fields: [sourceSessionId], references: [id], onDelete: Restrict)
  /// Pago neto acordado (≥ 0; puede ser $0).
  originalAmount  Decimal                 @db.Decimal(14, 2)
  status          SettlementPayableStatus
  createdById     String
  createdBy       User                    @relation("SettlementPayableCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt       DateTime                @default(now())
  paidAt          DateTime?
  voidedAt        DateTime?

  payouts SettlementPayout[]

  @@index([status, createdAt])
  @@index([playerId])
  @@index([sourceSessionId])
  @@map("settlement_payables")
}

/// Desembolso al jugador. Efectivo: nace EXECUTED con su asiento.
/// Transferencia: PENDING (reserva) → EXECUTED (asiento banco) | FAILED |
/// CANCELLED. Nunca se borra; la base impide exceder la cuenta por pagar.
model SettlementPayout {
  id                     String                  @id @default(cuid())
  payableId              String
  payable                SettlementPayable       @relation(fields: [payableId], references: [id], onDelete: Restrict)
  settlementId           String
  settlement             PlayerSettlement        @relation(fields: [settlementId], references: [id], onDelete: Restrict)
  playerId               String
  player                 Player                  @relation(fields: [playerId], references: [id], onDelete: Restrict)
  /// Orden del desembolso dentro de la liquidación (1, 2, 3…).
  sequence               Int
  amount                 Decimal                 @db.Decimal(14, 2)
  method                 SettlementPayoutMethod
  funding                SettlementPayoutFunding
  status                 SettlementPayoutStatus
  /// Caja de sesión usada (SESSION_CASH).
  sessionId              String?
  session                PokerSession?           @relation("SettlementPayoutSession", fields: [sessionId], references: [id], onDelete: Restrict)
  /// Custodio del efectivo administrativo (ADMIN_CUSTODY).
  custodianUserId        String?
  custodian              User?                   @relation("SettlementPayoutCustodian", fields: [custodianUserId], references: [id], onDelete: Restrict)
  /// Cuenta de origen autorizada (BANK).
  paymentAccountId       String?
  paymentAccount         PaymentAccount?         @relation(fields: [paymentAccountId], references: [id], onDelete: Restrict)
  bankReference          String?
  /// Asiento del desembolso (único: no se contabiliza dos veces).
  financialTransactionId String?                 @unique
  financialTransaction   CashTransaction?        @relation("SettlementPayoutTransaction", fields: [financialTransactionId], references: [id], onDelete: Restrict)
  notes                  String?
  failureReason          String?
  requestedById          String
  requestedBy            User                    @relation("SettlementPayoutRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)
  createdAt              DateTime                @default(now())
  resolvedById           String?
  resolvedBy             User?                   @relation("SettlementPayoutResolvedBy", fields: [resolvedById], references: [id], onDelete: Restrict)
  resolvedAt             DateTime?
  /// Fecha real de ejecución (efectivo: al entregar; banco: la verificada).
  executedAt             DateTime?
  idempotencyKey         String                  @unique
  resolveIdempotencyKey  String?                 @unique
  updatedAt              DateTime                @updatedAt

  receipt SettlementReceipt?

  @@unique([settlementId, sequence])
  @@index([payableId, status])
  @@index([status, createdAt])
  @@map("settlement_payouts")
}

/// Comprobante DIGITAL (no PDF): uno de recepción por liquidación y un
/// anexo por desembolso ejecutado. Snapshot inmutable con huella.
model SettlementReceipt {
  id           String                @id @default(cuid())
  settlementId String
  settlement   PlayerSettlement      @relation(fields: [settlementId], references: [id], onDelete: Restrict)
  kind         SettlementReceiptKind
  payoutId     String?               @unique
  payout       SettlementPayout?     @relation(fields: [payoutId], references: [id], onDelete: Restrict)
  status       ReceiptStatus         @default(AVAILABLE)
  content      Json
  contentHash  String
  createdById  String
  createdBy    User                  @relation("SettlementReceiptCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt    DateTime              @default(now())
  voidedAt     DateTime?
  voidReason   String?

  @@index([settlementId, kind])
  @@map("settlement_receipts")
}

/// Reverso auditado de una liquidación confirmada SIN desembolsos reales
/// (contraasientos de compensación, regreso nominal de fichas al jugador y
/// anulación de la cuenta por pagar). Solo inserción.
model SettlementReversal {
  id              String           @id @default(cuid())
  settlementId    String           @unique
  settlement      PlayerSettlement @relation(fields: [settlementId], references: [id], onDelete: Restrict)
  reason          String
  /// Operación nominal con la que las fichas regresaron al jugador.
  chipOperationId String?          @unique
  createdById     String
  createdBy       User             @relation("SettlementReversalCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt       DateTime         @default(now())
  idempotencyKey  String           @unique

  @@map("settlement_reversals")
}

// ── Módulo 12: cierre de mesas, sesiones y conciliación final ─────────
// Ver docs/MODULE_12_CLOSURE.md. Reutiliza el motor de arqueos de fichas
// (Módulo 04, countType CLOSING), el arqueo de efectivo (Módulo 05, tipo
// CLOSING) y el libro financiero: aquí solo hay el proceso, evidencias,
// autorizaciones y el comprobante. No hay campos de saldo editables.

/// Un intento de cierre (CLOSING). Si la sesión regresa a OPEN, el intento
/// queda RETURNED_TO_OPEN (se conserva) y el siguiente es un intento nuevo.
enum SessionClosureStatus {
  IN_PROGRESS
  RETURNED_TO_OPEN
  COMPLETED
}

/// NO_ACTIVITY: la sesión nunca abrió una mesa (cierre con motivo).
enum SessionClosureKind {
  NORMAL
  NO_ACTIVITY
}

enum ClosurePrecheckStage {
  START
  CONFIRM
}

enum ClosureDiscrepancyKind {
  CHIP_INVENTORY
  CASH
}

enum ClosureDiscrepancyStatus {
  OPEN
  RESOLVED
}

/// A: recuento físico; B: regreso auditado a OPEN; C: ajuste excepcional
/// autorizado por PARTNER/SUPERADMIN.
enum ClosureDiscrepancyResolution {
  RECOUNT
  RETURNED_TO_OPEN
  AUTHORIZED_ADJUSTMENT
}

model SessionClosure {
  id                   String               @id @default(cuid())
  sessionId            String
  session              PokerSession         @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  attemptNumber        Int
  status               SessionClosureStatus @default(IN_PROGRESS)
  /// Clasificación derivada al iniciar (sin ciclos de mesa → NO_ACTIVITY).
  kind                 SessionClosureKind
  noActivityReason     String?
  startedById          String
  startedBy            User                 @relation("ClosureStartedBy", fields: [startedById], references: [id], onDelete: Restrict)
  startedAt            DateTime             @default(now())
  startIdempotencyKey  String               @unique
  returnedAt           DateTime?
  returnedById         String?
  returnedBy           User?                @relation("ClosureReturnedBy", fields: [returnedById], references: [id], onDelete: Restrict)
  returnReason         String?
  /// Hora INFORMADA de la operación olvidada (la de captura es la real del servidor).
  forgottenOperationAt DateTime?
  returnIdempotencyKey String?              @unique
  completedAt          DateTime?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  statusHistory ClosureStatusHistory[]
  prechecks     ClosurePrecheck[]
  discrepancies ClosureDiscrepancy[]
  adjustments   ClosureAdjustmentAuthorization[]
  withdrawal    ClosureCashWithdrawal?
  approval      ClosureApproval?
  report        ClosureReport?

  @@unique([sessionId, attemptNumber])
  @@index([sessionId, status])
  @@map("session_closures")
}

/// Historial inmutable de un intento de cierre.
model ClosureStatusHistory {
  id          String                @id @default(cuid())
  closureId   String
  closure     SessionClosure        @relation(fields: [closureId], references: [id], onDelete: Restrict)
  fromStatus  SessionClosureStatus?
  toStatus    SessionClosureStatus
  changedById String
  changedBy   User                  @relation("ClosureStatusChangedBy", fields: [changedById], references: [id], onDelete: Restrict)
  changedAt   DateTime              @default(now())
  reason      String?

  @@index([closureId, changedAt])
  @@map("closure_status_history")
}

/// Fotografía inmutable de la prevalidación (al iniciar y al confirmar).
model ClosurePrecheck {
  id            String               @id @default(cuid())
  closureId     String
  closure       SessionClosure       @relation(fields: [closureId], references: [id], onDelete: Restrict)
  sessionId     String
  stage         ClosurePrecheckStage
  blockingCount Int
  warningCount  Int
  infoCount     Int
  findings      Json
  findingsHash  String
  createdById   String
  createdBy     User                 @relation("ClosurePrecheckBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt     DateTime             @default(now())

  @@index([closureId, createdAt])
  @@map("closure_prechecks")
}

/// Diferencia FÍSICA detectada por un arqueo de cierre (fichas o efectivo).
/// Importes inmutables; solo cambia su resolución (OPEN → RESOLVED, una vez).
/// Nunca representa fichas pendientes de retorno (eso es circulación).
model ClosureDiscrepancy {
  id                          String                        @id @default(cuid())
  closureId                   String
  closure                     SessionClosure                @relation(fields: [closureId], references: [id], onDelete: Restrict)
  sessionId                   String
  kind                        ClosureDiscrepancyKind
  chipStockCountId            String?                       @unique
  chipStockCount              ChipStockCount?               @relation("ClosureDiscrepancyChipCount", fields: [chipStockCountId], references: [id], onDelete: Restrict)
  cashReconciliationId        String?                       @unique
  cashReconciliation          CashReconciliation?           @relation("ClosureDiscrepancyCashCount", fields: [cashReconciliationId], references: [id], onDelete: Restrict)
  expectedAmount              Decimal                       @db.Decimal(14, 2)
  countedAmount               Decimal                       @db.Decimal(14, 2)
  differenceAmount            Decimal                       @db.Decimal(14, 2)
  status                      ClosureDiscrepancyStatus      @default(OPEN)
  detectedAt                  DateTime                      @default(now())
  /// Seguimiento de la investigación (texto libre, no cambia importes).
  investigationNotes          String?
  resolution                  ClosureDiscrepancyResolution?
  resolutionNotes             String?
  resolvedAt                  DateTime?
  resolvedById                String?
  resolvedBy                  User?                         @relation("ClosureDiscrepancyResolvedBy", fields: [resolvedById], references: [id], onDelete: Restrict)
  /// Recuento que sustituyó a este arqueo (resolución RECOUNT).
  recountChipStockCountId     String?
  recountCashReconciliationId String?
  createdAt                   DateTime                      @default(now())
  updatedAt                   DateTime                      @updatedAt

  adjustment ClosureAdjustmentAuthorization?

  @@index([closureId, status])
  @@index([sessionId])
  @@map("closure_discrepancies")
}

/// Ajuste EXCEPCIONAL autorizado por PARTNER/SUPERADMIN. No oculta la
/// diferencia original (queda en el arqueo y en la discrepancia). Único por
/// discrepancia; referencia el movimiento real (inventario o efectivo).
model ClosureAdjustmentAuthorization {
  id                String                  @id @default(cuid())
  discrepancyId     String                  @unique
  discrepancy       ClosureDiscrepancy      @relation(fields: [discrepancyId], references: [id], onDelete: Restrict)
  closureId         String
  closure           SessionClosure          @relation(fields: [closureId], references: [id], onDelete: Restrict)
  sessionId         String
  /// Diferencia ajustada (con signo: negativo = faltante).
  amount            Decimal                 @db.Decimal(14, 2)
  reason            String
  authorizedById    String
  authorizedBy      User                    @relation("ClosureAdjustmentAuthorizedBy", fields: [authorizedById], references: [id], onDelete: Restrict)
  chipOperationId   String?                 @unique
  chipOperation     ChipInventoryOperation? @relation("ClosureAdjustmentChipOperation", fields: [chipOperationId], references: [id], onDelete: Restrict)
  cashTransactionId String?                 @unique
  cashTransaction   CashTransaction?        @relation("ClosureAdjustmentCashTransaction", fields: [cashTransactionId], references: [id], onDelete: Restrict)
  idempotencyKey    String                  @unique
  createdAt         DateTime                @default(now())

  @@index([closureId])
  @@map("closure_adjustment_authorizations")
}

/// Retiro final de efectivo: salida física REAL que deja la caja en $0.
/// El receptor no inicia sesión ni firma: el operador declara la entrega.
model ClosureCashWithdrawal {
  id                   String             @id @default(cuid())
  closureId            String             @unique
  closure              SessionClosure     @relation(fields: [closureId], references: [id], onDelete: Restrict)
  sessionId            String
  amount               Decimal            @db.Decimal(14, 2)
  withdrawnById        String
  withdrawnBy          User               @relation("ClosureWithdrawalBy", fields: [withdrawnById], references: [id], onDelete: Restrict)
  recipientName        String
  recipientUserId      String?
  recipientUser        User?              @relation("ClosureWithdrawalRecipient", fields: [recipientUserId], references: [id], onDelete: Restrict)
  withdrawalAt         DateTime           @default(now())
  notes                String?
  cashTransactionId    String             @unique
  cashTransaction      CashTransaction    @relation("ClosureWithdrawalTransaction", fields: [cashTransactionId], references: [id], onDelete: Restrict)
  cashReconciliationId String
  cashReconciliation   CashReconciliation @relation("ClosureWithdrawalCashCount", fields: [cashReconciliationId], references: [id], onDelete: Restrict)
  idempotencyKey       String             @unique

  @@index([sessionId])
  @@map("closure_cash_withdrawals")
}

/// Autorización definitiva (PARTNER/SUPERADMIN) ligada a la huella del
/// resumen revisado y a los arqueos finales usados.
model ClosureApproval {
  id                   String             @id @default(cuid())
  closureId            String             @unique
  closure              SessionClosure     @relation(fields: [closureId], references: [id], onDelete: Restrict)
  sessionId            String             @unique
  approvedById         String
  approvedBy           User               @relation("ClosureApprovedBy", fields: [approvedById], references: [id], onDelete: Restrict)
  approvedAt           DateTime           @default(now())
  previewHash          String
  chipStockCountId     String?            @unique
  chipStockCount       ChipStockCount?    @relation("ClosureApprovalChipCount", fields: [chipStockCountId], references: [id], onDelete: Restrict)
  cashReconciliationId String             @unique
  cashReconciliation   CashReconciliation @relation("ClosureApprovalCashCount", fields: [cashReconciliationId], references: [id], onDelete: Restrict)
  idempotencyKey       String             @unique

  @@map("closure_approvals")
}

/// Comprobante digital INMUTABLE del cierre (snapshot + huella). Los
/// movimientos posteriores (transferencias, pagos, canjes) no lo cambian.
model ClosureReport {
  id          String             @id @default(cuid())
  closureId   String             @unique
  closure     SessionClosure     @relation(fields: [closureId], references: [id], onDelete: Restrict)
  sessionId   String             @unique
  session     PokerSession       @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  folio       String             @unique
  kind        SessionClosureKind
  content     Json
  contentHash String
  createdById String
  createdBy   User               @relation("ClosureReportCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime           @default(now())

  @@map("closure_reports")
}

// ── Módulo 15: auditoría, administración, integridad, incidencias,
// respaldos y recuperación ─────────────────────────────────────────────
// Ver docs/MODULE_15_AUDIT_ADMIN_BACKUP.md. Nada de esto es una segunda
// contabilidad: no hay saldos ni movimientos; solo procesos, hallazgos y
// evidencias de infraestructura. La auditoría sigue en `audit_logs`.

enum CorrectionType {
  /// Reverso de un abono confirmado (servicio real del Módulo 10).
  RECEIVABLE_PAYMENT_REVERSAL
  /// Reverso de un movimiento de caja (servicio real del Módulo 05).
  CASH_MOVEMENT_REVERSAL
  /// Reverso de una liquidación SIN pagos reales (servicio real del Módulo 11).
  SETTLEMENT_REVERSAL
  // ── Pendientes del Módulo 16 (sin servicio de ejecución) ──
  PURCHASE_REVERSAL
  SETTLEMENT_REVERSAL_WITH_PAYOUTS
  UNAPPLIED_FUNDS_RETURN
  LATE_CHIP_REDEMPTION
  /// Otra corrección documentada (sin ejecución automática).
  OTHER
}

enum CorrectionStatus {
  REQUESTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  EXECUTED
  FAILED
  CANCELLED
}

/// Solicitud de corrección financiera excepcional. Aprobarla NO mueve
/// saldos: solo se marca EXECUTED al enlazar una operación REAL registrada
/// por el servicio legítimo de su módulo (verificada al enlazar).
model CorrectionRequest {
  id                     String           @id @default(cuid())
  folio                  String           @unique
  type                   CorrectionType
  module                 String
  /// Movimiento u operación original (tipo de entidad + id).
  targetType             String
  targetId               String
  sessionId              String?
  playerId               String?
  amount                 Decimal?         @db.Decimal(14, 2)
  reason                 String
  evidenceNote           String?
  status                 CorrectionStatus @default(REQUESTED)
  version                Int              @default(1)
  requestedById          String
  requestedBy            User             @relation("CorrectionRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)
  requestedAt            DateTime         @default(now())
  idempotencyKey         String           @unique
  /// Referencia de ejecución: operación real del módulo de origen.
  executionReferenceType String?
  executionReferenceId   String?
  executedById           String?
  executedBy             User?            @relation("CorrectionExecutedBy", fields: [executedById], references: [id], onDelete: Restrict)
  executedAt             DateTime?
  executionNotes         String?
  updatedAt              DateTime         @updatedAt

  approval             CorrectionApproval?
  events               CorrectionEvent[]
  purchaseReversal     PurchaseReversal?     @relation("PurchaseReversalCorrection")
  settlementCorrection SettlementCorrection? @relation("SettlementCorrectionRequest")

  @@unique([executionReferenceType, executionReferenceId])
  @@index([status, requestedAt])
  @@index([targetType, targetId])
  @@index([requestedById])
  @@map("correction_requests")
}

enum CorrectionDecision {
  APPROVED
  REJECTED
}

/// Decisión ÚNICA de PARTNER/SUPERADMIN sobre una solicitud (inmutable).
model CorrectionApproval {
  id           String             @id @default(cuid())
  correctionId String             @unique
  correction   CorrectionRequest  @relation(fields: [correctionId], references: [id], onDelete: Restrict)
  decision     CorrectionDecision
  decidedById  String
  decidedBy    User               @relation("CorrectionDecidedBy", fields: [decidedById], references: [id], onDelete: Restrict)
  decidedRole  Role
  notes        String
  decidedAt    DateTime           @default(now())

  @@map("correction_approvals")
}

enum CorrectionEventKind {
  CREATED
  COMMENT
  STATUS_CHANGED
  EXECUTION_LINKED
}

/// Historial inmutable de una solicitud (comentarios y cambios de estado).
model CorrectionEvent {
  id           String              @id @default(cuid())
  correctionId String
  correction   CorrectionRequest   @relation(fields: [correctionId], references: [id], onDelete: Restrict)
  kind         CorrectionEventKind
  fromStatus   CorrectionStatus?
  toStatus     CorrectionStatus?
  notes        String?
  actorId      String
  actor        User                @relation("CorrectionEventActor", fields: [actorId], references: [id], onDelete: Restrict)
  createdAt    DateTime            @default(now())

  @@index([correctionId, createdAt])
  @@map("correction_events")
}

enum IntegrityRunStatus {
  RUNNING
  COMPLETED
  FAILED
}

enum IntegrityStatus {
  OK
  WARNING
  ERROR
  NOT_EVALUATED
}

enum FindingSeverity {
  INFO
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

/// Ejecución del motor de integridad (solo lectura; nunca repara).
model IntegrityCheckRun {
  id            String             @id @default(cuid())
  status        IntegrityRunStatus @default(RUNNING)
  trigger       String
  triggeredById String?
  triggeredBy   User?              @relation("IntegrityRunTriggeredBy", fields: [triggeredById], references: [id], onDelete: Restrict)
  startedAt     DateTime           @default(now())
  finishedAt    DateTime?
  summary       Json?
  error         String?

  findings IntegrityFinding[]

  @@index([startedAt])
  @@map("integrity_check_runs")
}

/// Resultado de UNA comprobación (o de una entidad que la incumple).
model IntegrityFinding {
  id          String            @id @default(cuid())
  runId       String
  run         IntegrityCheckRun @relation(fields: [runId], references: [id], onDelete: Restrict)
  checkCode   String
  category    String
  status      IntegrityStatus
  severity    FindingSeverity
  entityType  String?
  entityId    String?
  expected    String?
  actual      String?
  difference  String?
  explanation String
  references  Json?
  /// checkCode + entidad: identifica el MISMO hallazgo entre ejecuciones.
  fingerprint String
  checkedAt   DateTime          @default(now())

  incidents OperationalIncident[]

  @@index([runId, status])
  @@index([fingerprint])
  @@map("integrity_findings")
}

enum IncidentStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  DISMISSED
}

enum IncidentSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IncidentSource {
  MANUAL
  INTEGRITY
  BACKUP
  RESTORE
  SECURITY
}

/// Incidencia operativa. Nunca se borra; un hallazgo repetido no crea
/// otra mientras la anterior siga abierta (índice parcial por huella).
model OperationalIncident {
  id           String            @id @default(cuid())
  folio        String            @unique
  title        String
  description  String
  severity     IncidentSeverity
  status       IncidentStatus    @default(OPEN)
  source       IncidentSource
  fingerprint  String?
  findingId    String?
  finding      IntegrityFinding? @relation(fields: [findingId], references: [id], onDelete: Restrict)
  entityType   String?
  entityId     String?
  occurrences  Int               @default(1)
  lastSeenAt   DateTime          @default(now())
  assignedToId String?
  assignedTo   User?             @relation("IncidentAssignedTo", fields: [assignedToId], references: [id], onDelete: Restrict)
  createdById  String?
  createdBy    User?             @relation("IncidentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt    DateTime          @default(now())
  resolvedById String?
  resolvedBy   User?             @relation("IncidentResolvedBy", fields: [resolvedById], references: [id], onDelete: Restrict)
  resolvedAt   DateTime?
  resolution   String?
  version      Int               @default(1)
  updatedAt    DateTime          @updatedAt

  history IncidentHistory[]

  @@index([status, severity])
  @@index([createdAt])
  @@map("operational_incidents")
}

enum IncidentEventKind {
  CREATED
  REOCCURRED
  STATUS_CHANGED
  ASSIGNED
  COMMENT
  EVIDENCE
}

/// Historial inmutable de una incidencia.
model IncidentHistory {
  id         String              @id @default(cuid())
  incidentId String
  incident   OperationalIncident @relation(fields: [incidentId], references: [id], onDelete: Restrict)
  kind       IncidentEventKind
  fromStatus IncidentStatus?
  toStatus   IncidentStatus?
  notes      String?
  actorId    String?
  actor      User?               @relation("IncidentHistoryActor", fields: [actorId], references: [id], onDelete: Restrict)
  createdAt  DateTime            @default(now())

  @@index([incidentId, createdAt])
  @@map("incident_history")
}

enum BackupStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
  PARTIAL
  VERIFICATION_FAILED
}

enum BackupTrigger {
  SCHEDULED
  MANUAL
}

enum VerificationStatus {
  NOT_VERIFIED
  PASSED
  FAILED
}

/// Ejecución REAL de un respaldo (instantánea lógica consistente de la
/// base, incluidas las evidencias `evidence_blobs`). Nunca guarda claves:
/// solo la huella de la clave de cifrado.
model BackupExecution {
  id                 String             @id @default(cuid())
  trigger            BackupTrigger
  status             BackupStatus       @default(PENDING)
  /// Clave de idempotencia (p. ej. "daily:2026-10-21"): un diario por día.
  idempotencyKey     String             @unique
  triggeredById      String?
  triggeredBy        User?              @relation("BackupTriggeredBy", fields: [triggeredById], references: [id], onDelete: Restrict)
  startedAt          DateTime           @default(now())
  finishedAt         DateTime?
  /// Instante del snapshot (hora del servidor de BD al iniciar la lectura).
  recoveryPoint      DateTime?
  schemaVersion      String?
  migrationsCount    Int?
  destination        String
  location           String?
  tableCount         Int?
  rowCount           Int?
  evidenceCount      Int?
  sizeBytes          BigInt?
  artifactSha256     String?
  encryption         String?
  keyFingerprint     String?
  manifest           Json?
  verificationStatus VerificationStatus @default(NOT_VERIFIED)
  verifiedAt         DateTime?
  verificationError  String?
  error              String?
  host               String?
  /// La política de retención eliminó el artefacto (el registro se conserva).
  prunedAt           DateTime?

  artifacts          BackupArtifact[]
  restoreValidations RestoreValidation[]
  restoreRequests    RestoreRequest[]

  @@index([status, startedAt])
  @@index([trigger, startedAt])
  @@map("backup_executions")
}

enum BackupArtifactKind {
  DATABASE_SNAPSHOT
  MANIFEST
}

model BackupArtifact {
  id        String             @id @default(cuid())
  backupId  String
  backup    BackupExecution    @relation(fields: [backupId], references: [id], onDelete: Restrict)
  kind      BackupArtifactKind
  path      String
  sizeBytes BigInt
  sha256    String
  createdAt DateTime           @default(now())

  @@unique([backupId, kind])
  @@map("backup_artifacts")
}

enum RestoreValidationStatus {
  RUNNING
  PASSED
  FAILED
}

/// Prueba REAL de restauración en un entorno aislado (nunca producción).
model RestoreValidation {
  id                String                  @id @default(cuid())
  backupId          String
  backup            BackupExecution         @relation(fields: [backupId], references: [id], onDelete: Restrict)
  status            RestoreValidationStatus @default(RUNNING)
  trigger           String
  requestedById     String?
  requestedBy       User?                   @relation("RestoreValidationRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)
  /// Huella (hash) del destino aislado; nunca la cadena de conexión.
  targetFingerprint String
  startedAt         DateTime                @default(now())
  finishedAt        DateTime?
  checks            Json?
  error             String?
  cleanedUp         Boolean                 @default(false)

  restoreRequests RestoreRequest[]

  @@index([backupId, startedAt])
  @@index([status, startedAt])
  @@map("restore_validations")
}

enum RestoreRequestStatus {
  REQUESTED
  VALIDATING
  VALIDATED
  APPROVED
  EXECUTING
  COMPLETED
  FAILED
  CANCELLED
}

/// Solicitud de RECUPERACIÓN (solo SUPERADMIN). La ejecución nunca ocurre
/// por HTTP: la realiza el procedimiento protegido por CLI, en un destino
/// NUEVO, tras una validación aislada aprobada.
model RestoreRequest {
  id                 String               @id @default(cuid())
  backupId           String
  backup             BackupExecution      @relation(fields: [backupId], references: [id], onDelete: Restrict)
  validationId       String?
  validation         RestoreValidation?   @relation(fields: [validationId], references: [id], onDelete: Restrict)
  reason             String
  status             RestoreRequestStatus @default(REQUESTED)
  requestedById      String
  requestedBy        User                 @relation("RestoreRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)
  requestedAt        DateTime             @default(now())
  approvedById       String?
  approvedBy         User?                @relation("RestoreApprovedBy", fields: [approvedById], references: [id], onDelete: Restrict)
  approvedAt         DateTime?
  recoveryPoint      DateTime?
  /// Evaluación de datos posteriores al punto de recuperación (se perderían).
  dataAfterRecovery  Json?
  plan               String?
  executionReference String?
  result             String?
  notes              String?
  idempotencyKey     String               @unique
  version            Int                  @default(1)
  updatedAt          DateTime             @updatedAt

  @@index([status, requestedAt])
  @@map("restore_requests")
}

/// Modo mantenimiento (fila única id = 1). Con `enabled` la API rechaza
/// escrituras de negocio (503); lo activa SUPERADMIN para recuperar.
model SystemMaintenance {
  id          Int       @id @default(1)
  enabled     Boolean   @default(false)
  reason      String?
  changedById String?
  changedBy   User?     @relation("MaintenanceChangedBy", fields: [changedById], references: [id], onDelete: Restrict)
  changedAt   DateTime?

  @@map("system_maintenance")
}

// ── Módulo 16: operaciones financieras especiales ─────────────────────
// Ver docs/MODULE_16_SPECIAL_OPERATIONS.md. Reutiliza los libros reales:
// inventario nominal (Módulo 04), libro financiero (Módulo 05), motor de
// aplicaciones (Módulo 10) y autorizaciones (Módulo 15). Aquí solo hay
// expedientes, obligaciones, pagos y evidencias: ningún saldo editable.

enum LateRedemptionStatus {
  REQUESTED
  VALIDATING
  REJECTED
  PAYMENT_PENDING
  PARTIALLY_PAID
  PAID
  CANCELLED
}

/// Canje POSTERIOR de fichas presentadas físicamente fuera de su sesión.
/// La entrada nominal ocurre UNA vez al confirmar la recepción física.
model LateChipRedemption {
  id               String               @id @default(cuid())
  folio            String               @unique
  status           LateRedemptionStatus @default(REQUESTED)
  presenterName    String
  playerId         String?
  player           Player?              @relation("RedemptionPlayer", fields: [playerId], references: [id], onDelete: Restrict)
  /// Sesión de origen SOLO si se conoce con evidencia (informativa).
  originSessionId  String?
  originSession    PokerSession?        @relation("RedemptionOriginSession", fields: [originSessionId], references: [id], onDelete: Restrict)
  originEvidence   String?
  presentedNominal Decimal              @db.Decimal(14, 2)
  acceptedNominal  Decimal?             @db.Decimal(14, 2)
  rejectedNominal  Decimal?             @db.Decimal(14, 2)
  /// Conteo por denominación del retorno ACTUAL (no se atribuye a compras).
  denominations    Json?
  validationNotes  String?
  validatedAt      DateTime?
  chipOperationId  String?              @unique
  receivedById     String?
  receivedBy       User?                @relation("RedemptionReceivedBy", fields: [receivedById], references: [id], onDelete: Restrict)
  receivedAt       DateTime?
  notes            String?
  requestedById    String
  requestedBy      User                 @relation("RedemptionRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)
  requestedAt      DateTime             @default(now())
  cancelledAt      DateTime?
  cancelReason     String?
  idempotencyKey   String               @unique
  version          Int                  @default(1)
  updatedAt        DateTime             @updatedAt

  @@index([status, requestedAt])
  @@index([playerId])
  @@map("late_chip_redemptions")
}

enum SpecialPayableKind {
  REDEMPTION
  PURCHASE_REFUND
  SETTLEMENT_ADJUSTMENT
  UNAPPLIED_REFUND
}

enum SpecialPayableStatus {
  OPEN
  PARTIALLY_PAID
  PAID
}

/// Obligación por pagar nacida de una operación especial (una por origen).
/// El saldo se DERIVA de sus pagos EXECUTED; nunca se edita.
model SpecialPayable {
  id              String               @id @default(cuid())
  kind            SpecialPayableKind
  sourceType      String
  sourceId        String
  playerId        String?
  player          Player?              @relation("SpecialPayablePlayer", fields: [playerId], references: [id], onDelete: Restrict)
  beneficiaryName String
  /// Sesión de origen (solo para permitir efectivo de ESA sesión si sigue abierta).
  sessionId       String?
  originalAmount  Decimal              @db.Decimal(14, 2)
  status          SpecialPayableStatus @default(OPEN)
  createdById     String
  createdBy       User                 @relation("SpecialPayableCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt       DateTime             @default(now())
  paidAt          DateTime?

  payouts SpecialPayout[]

  @@unique([kind, sourceId])
  @@index([status, createdAt])
  @@index([playerId])
  @@map("special_payables")
}

enum SpecialPayoutStatus {
  PENDING
  EXECUTED
  FAILED
  CANCELLED
}

/// Desembolso REAL de una obligación especial. Efectivo: se contabiliza al
/// entregarlo. Transferencia: PENDING (reserva, no es pago) → EXECUTED.
model SpecialPayout {
  id                     String                  @id @default(cuid())
  folio                  String                  @unique
  payableId              String
  payable                SpecialPayable          @relation(fields: [payableId], references: [id], onDelete: Restrict)
  sequence               Int
  amount                 Decimal                 @db.Decimal(14, 2)
  method                 SettlementPayoutMethod
  funding                SettlementPayoutFunding
  status                 SpecialPayoutStatus
  sessionId              String?
  custodianUserId        String?
  custodian              User?                   @relation("SpecialPayoutCustodian", fields: [custodianUserId], references: [id], onDelete: Restrict)
  bankReference          String?
  financialTransactionId String?                 @unique
  financialTransaction   CashTransaction?        @relation("SpecialPayoutTransaction", fields: [financialTransactionId], references: [id], onDelete: Restrict)
  notes                  String?
  failureReason          String?
  requestedById          String
  requestedBy            User                    @relation("SpecialPayoutRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)
  createdAt              DateTime                @default(now())
  resolvedById           String?
  resolvedBy             User?                   @relation("SpecialPayoutResolvedBy", fields: [resolvedById], references: [id], onDelete: Restrict)
  resolvedAt             DateTime?
  executedAt             DateTime?
  idempotencyKey         String                  @unique
  resolveIdempotencyKey  String?                 @unique

  @@unique([payableId, sequence])
  @@index([payableId, status])
  @@index([status, createdAt])
  @@map("special_payouts")
}

/// Reverso COMPLETO ejecutado de una compra confirmada (hecho, no solicitud).
model PurchaseReversal {
  id                 String            @id @default(cuid())
  folio              String            @unique
  purchaseId         String            @unique
  purchase           ChipPurchase      @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  correctionId       String            @unique
  correction         CorrectionRequest @relation("PurchaseReversalCorrection", fields: [correctionId], references: [id], onDelete: Restrict)
  chipOperationId    String            @unique
  returnedNominal    Decimal           @db.Decimal(14, 2)
  /// Saldo de la deuda extinguido sin dinero (fichas devueltas).
  extinguishedAmount Decimal           @db.Decimal(14, 2)
  /// Dinero que el jugador había pagado por la compra → se le debe.
  refundAmount       Decimal           @db.Decimal(14, 2)
  plan               Json
  reason             String
  executedById       String
  executedBy         User              @relation("PurchaseReversalExecutedBy", fields: [executedById], references: [id], onDelete: Restrict)
  executedAt         DateTime          @default(now())
  idempotencyKey     String            @unique

  extinctions PaymentAllocation[] @relation("ReversalExtinctions")

  @@map("purchase_reversals")
}

enum SettlementCorrectionKind {
  /// El negocio debe pagar una diferencia adicional.
  ADDITIONAL_PAYOUT
  /// Se revierte la compensación FIFO (contraasientos) y su valor se paga.
  OFFSET_REVERSAL
}

/// Corrección EJECUTADA de una liquidación recibida (efectos nuevos; la
/// liquidación, su firma, sus pagos y su caja quedan intactos).
model SettlementCorrection {
  id             String                   @id @default(cuid())
  folio          String                   @unique
  settlementId   String
  settlement     PlayerSettlement         @relation("SettlementCorrections", fields: [settlementId], references: [id], onDelete: Restrict)
  kind           SettlementCorrectionKind
  correctionId   String                   @unique
  correction     CorrectionRequest        @relation("SettlementCorrectionRequest", fields: [correctionId], references: [id], onDelete: Restrict)
  amount         Decimal                  @db.Decimal(14, 2)
  reason         String
  evidenceId     String                   @unique
  executedById   String
  executedBy     User                     @relation("SettlementCorrectionExecutedBy", fields: [executedById], references: [id], onDelete: Restrict)
  executedAt     DateTime                 @default(now())
  idempotencyKey String                   @unique

  @@index([settlementId])
  @@map("settlement_corrections")
}

/// Aceptación firmada (canje o corrección). Snapshot canónico + huella;
/// la imagen vive en el almacenamiento privado. Inmutable.
model SpecialOperationEvidence {
  id              String     @id @default(cuid())
  sourceType      String
  sourceId        String
  content         Json
  contentHash     String
  declarationText String
  signerName      String
  playerId        String?
  fileId          String     @unique
  file            StoredFile @relation("SpecialEvidenceFile", fields: [fileId], references: [id], onDelete: Restrict)
  capturedById    String
  capturedBy      User       @relation("SpecialEvidenceCapturedBy", fields: [capturedById], references: [id], onDelete: Restrict)
  signedAt        DateTime   @default(now())

  @@unique([sourceType, sourceId])
  @@map("special_operation_evidence")
}

/// Comprobante complementario inmutable (PNG desde el snapshot).
model SpecialOperationReceipt {
  id          String   @id @default(cuid())
  kind        String
  sourceKey   String   @unique
  title       String
  content     Json
  contentHash String
  createdById String
  createdBy   User     @relation("SpecialReceiptCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now())

  @@index([kind, createdAt])
  @@map("special_operation_receipts")
}
